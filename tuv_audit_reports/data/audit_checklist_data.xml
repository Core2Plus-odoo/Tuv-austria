<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The audit checklists: one predefined form and one Reports card each.
         noupdate: what the users filled in on the predefined forms is kept on upgrade. -->
    <data noupdate="1">
        <record id="checklist_iso9001_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 9001</field></record>
        <record id="checklist_iso45001_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 45001</field></record>
        <record id="checklist_iso14001_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 14001</field></record>
        <record id="checklist_iso50001_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 50001</field></record>
        <record id="checklist_iso13485_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 13485</field></record>
        <record id="checklist_iso20000_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO/IEC 20000-1</field></record>
        <record id="checklist_iso37301_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 37301</field></record>
        <record id="checklist_combined_form" model="tuv.audit.plan"><field name="name">Audit Checklist Combined QM/EM/HSE/EN</field></record>
        <record id="checklist_iso27001_form" model="tuv.audit.plan"><field name="name">Audit Checklist ISO 27001</field></record>
    </data>

    <function model="tuv.audit.plan" name="write">
        <value eval="[ref('checklist_iso27001_form')]"/>
        <value eval="{'audit_report_key': 'checklist_iso27001', 'audit_report_uses_info': False, 'form_subtitle': 'Information Security Management System (ISO/IEC 27001:2022)', 'form_reference': 'FM-TAGMBH-MSZ-023_Audit-Checklist-ISO-27001-EN | Rev.01/17.10.2024'}"/>
    </function>
    <function model="tuv.audit.plan" name="_tuv_fill_isms_checklist">
        <value eval="[ref('checklist_iso27001_form')]"/>
    </function>

