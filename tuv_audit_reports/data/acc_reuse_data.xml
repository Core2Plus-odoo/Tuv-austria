    <record id="audit_report_doc_pnac_guide_45001" model="tuv.audit.report">
        <field name="name">Audit Guideline ISO 45001</field>
        <field name="accreditation">pnac</field>
        <field name="sequence">760</field>
        <field name="subtitle">Auditing guideline / ISO 45001:2018</field>
        <field name="code">FM-TAGMBH-MSZ-015</field>
        <field name="revision">01/17.10.24</field>
        <field name="document_name">FM-TAGMBH-MSZ-015_Audit-Guideline-ISO-45001-EN.docx</field>
        <field name="record_xmlid">tuv_audit_reports.doc_pnac_guide_45001_form</field>
        <field name="view_xmlid">tuv_audit_reports.tuv_audit_plan_view_form</field>
        <field name="report_action_xmlid">tuv_audit_reports.action_report_audit_document</field>
        <field name="report_key">doc_pnac_guide_45001</field>
        <field name="uses_audit_info" eval="False"/>
    </record>

    <!-- SAAC cards on forms identical to the TÜV Austria ones -->
    <record id="audit_report_saac_certificate_text" model="tuv.audit.report">
        <field name="name">Certificate Text</field>
        <field name="accreditation">saac</field>
        <field name="sequence">800</field>
        <field name="subtitle">Certification of Management Systems</field>
        <field name="code">FM-TAGMBH-MSZ-038</field>
        <field name="revision">02/17.10.2024</field>
        <field name="document_name">FM-TAGMBH-MSZ-038_Certificate-Text-EN.docx</field>
        <field name="record_xmlid">tuv_audit_reports.certificate_text_form</field>
        <field name="view_xmlid">tuv_audit_reports.tuv_audit_plan_view_form</field>
        <field name="report_action_xmlid">tuv_audit_reports.action_report_audit_certificate_text</field>
        <field name="report_key">certificate_text</field>
    </record>
    <record id="audit_report_saac_checklist_iso27001" model="tuv.audit.report">
        <field name="name">Audit Checklist ISO 27001</field>
        <field name="accreditation">saac</field>
        <field name="sequence">810</field>
        <field name="subtitle">Information Security Management System (ISO/IEC 27001:2022)</field>
        <field name="code">FM-TAGMBH-MSZ-023</field>
        <field name="revision">01/17.10.2024</field>
        <field name="document_name">FM-TAGMBH-MSZ-023_Audit-Checklist-ISO-27001-EN.xlsx</field>
        <field name="record_xmlid">tuv_audit_reports.checklist_iso27001_form</field>
        <field name="view_xmlid">tuv_audit_reports.tuv_audit_plan_view_form</field>
        <field name="report_action_xmlid">tuv_audit_reports.action_report_audit_checklist_isms</field>
        <field name="report_key">checklist_iso27001</field>
        <field name="uses_audit_info" eval="False"/>
    </record>

</odoo>
