<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Certificate text, form FM-TAGMBH-MSZ-038 (revision 02/17.10.2024, footer "Seite x von y").
         Page 1: sections 1 and 2; 2: contact and certificate issue; 3: sub certificates and the
         certificate wording; 4: standards, logo, notes, SoA and operator number. -->
    <record id="action_report_audit_certificate_text" model="ir.actions.report">
        <field name="name">Certificate Text</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tuv_audit_reports.report_audit_certificate_text</field>
        <field name="report_file">tuv_audit_reports.report_audit_certificate_text</field>
        <field name="print_report_name">'Certificate Text - %s' % (object.ap_partner_id.name or object.name)</field>
        <field name="paperformat_id" ref="paperformat_audit_plan"/>
    </record>

    <template id="report_audit_certificate_text">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="logo" t-value="o._ap_logo_data_uri()"/>
                <t t-set="form_title" t-value="'Certificate text'"/>
                <t t-set="form_subtitle" t-value="'Certification of Management Systems'"/>
                <t t-set="form_code" t-value="'FM-TAGMBH-MSZ-038_Certificate-Text-EN'"/>
                <t t-set="form_revision" t-value="'02/17.10.2024'"/>
                <t t-set="form_vkl" t-value="'Internal'"/>
                <t t-set="page_word" t-value="'Seite'"/>
                <t t-set="of_word" t-value="'von'"/>

                <div class="header">
                    <t t-call="tuv_audit_reports.form_page_header"/>
                </div>

                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <t t-call="tuv_audit_reports.audit_plan_style"/>
                    <style>
                        .ct { font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #000; }
                        .ct h3 { font-size: 17px; font-weight: bold; margin: 14px 0 10px 0; }
                        .ct p { margin: 0 0 10px 0; }
                        .ct .ul { border-bottom: 1px solid #000; min-height: 18px; display: inline-block; }
                        .ct table.plain { width: 100%; border-collapse: collapse; border: none; }
                        .ct table.plain td { border: none; padding: 4px 6px; vertical-align: bottom; }
                        .ct table.plain td.line { border-bottom: 1px solid #000; }
                        .ct .bigbox { border: 2px solid #000; min-height: 56px; padding: 6px; margin: 6px 0 16px 0; font-size: 14px; }
                        .ct .note { font-size: 10px; margin-bottom: 6px; }
                    </style>

                    <!-- ================= Page 1 ================= -->
                    <t t-call="tuv_audit_reports.form_sections_company_audit">
                        <t t-set="scope_label" t-value="'Company description, business activities'"/>
                        <t t-set="scope_value" t-value="'see scope of certification'"/>
                        <t t-set="sites_value" t-value="o.ap_other_sites or 'see audit report'"/>
                        <t t-set="duration_label" t-value="'see plan'"/>
                    </t>

                    <!-- ================= Page 2 ================= -->
                    <div style="page-break-before: always;"/>
                    <div class="ct">
                        <table class="tap" style="font-size: 13px;">
                            <tr><td class="lbl" style="width: 27%; height: 26px;">Contact person:</td><td t-out="o.ct_contact_person or ''"/></tr>
                            <tr><td class="lbl" style="height: 26px;">Phone:</td><td t-out="o.ct_phone or ''"/></tr>
                            <tr><td class="lbl" style="height: 26px;">Fax:</td><td t-out="o.ct_fax or ''"/></tr>
                            <tr><td class="lbl" style="height: 26px;">email:</td><td t-out="o.ct_email or ''"/></tr>
                        </table>
                        <h3>Certificate issue</h3>
                        <table class="plain" style="width: 70%;">
                            <tr>
                                <td style="width: 38%;">Desired certificate format:</td>
                                <td><t t-out="'☒' if o.ct_format_a3 else '☐'"/> A3</td>
                                <td><t t-out="'☒' if o.ct_format_a4 else '☐'"/> A4</td>
                                <td><t t-out="'☒' if o.ct_format_pdf else '☐'"/> pdf-file</td>
                            </tr>
                        </table>
                        <p style="margin-top: 12px;">Two certificates are included in the price for every certification and every recertification. The agreement in the offer is binding.</p>
                        <table class="plain">
                            <tr><td style="width: 25%;">Desired languages:</td><td class="line" t-out="o.ct_languages or ''"/></tr>
                            <tr><td>Number of certificates per language:</td><td class="line" t-out="o.ct_certificates_per_language or ''"/></tr>
                        </table>
                        <p style="margin-top: 12px;">Additional costs for additional certificates (if applicable):
                            <span class="ul" style="min-width: 260px;" t-out="o.ct_additional_costs or ''"/></p>
                        <p>Please enclose a translation in all desired languages of the scope of certification. (Else we must charge you for the translation)</p>
                        <p>For extra information and explanations please use an additional sheet. The client must be informed that it is only possible to deliver the certificates after the certification contract is signed.</p>
                    </div>

                    <!-- ================= Page 3 ================= -->
                    <div style="page-break-before: always;"/>
                    <div class="ct">
                        <h3 style="font-size: 14px; margin-top: 0;">Sub certificates: (optional)</h3>
                        <p>Sub certificates for the following sites including complete address and the scope of the certification for every site (the scope of certification of a sub certificate can be the same as in the main certificate or only a part of it):</p>
                        <table class="plain">
                            <t t-foreach="[o.ct_sub_certificate_1, o.ct_sub_certificate_2, o.ct_sub_certificate_3, o.ct_sub_certificate_4]" t-as="sub">
                                <tr>
                                    <td style="width: 4%; height: 30px;">0<t t-out="sub_index + 1"/>:</td>
                                    <td class="line"><t t-foreach="(sub or '').split('\n')" t-as="n"><t t-out="n"/><br t-if="not n_last"/></t></td>
                                </tr>
                            </t>
                        </table>
                        <p style="margin-top: 22px;">The certification body of TÜV AUSTRIA GMBH certifies in accordance with TÜV AUSTRIA procedures that the company (Note: Please state name, address, zip code and place) <sup>1)</sup></p>
                        <div class="bigbox"><t t-foreach="(o.ct_company_text or '').split('\n')" t-as="n"><t t-out="n"/><br t-if="not n_last"/></t></div>
                        <p>for the scope <sup>2)</sup></p>
                        <div class="bigbox"><t t-foreach="(o.ct_scope_text or '').split('\n')" t-as="n"><t t-out="n"/><br t-if="not n_last"/></t></div>
                        <p>applies a management system in line with the standard.</p>
                        <p style="margin-top: 16px;">It has been proven that the requirements of the standard</p>
                    </div>

                    <!-- ================= Page 4 ================= -->
                    <div style="page-break-before: always;"/>
                    <div class="ct">
                        <t t-set="grid" t-value="o._ct_standard_grid()"/>
                        <table class="tap" style="font-size: 13px;">
                            <tr t-foreach="[grid[0:4], grid[4:8], grid[8:12]]" t-as="row">
                                <td t-foreach="row" t-as="cell" style="width: 25%; height: 24px;">
                                    <t t-out="'☒' if cell[1] else '☐'"/> <t t-out="cell[0]"/>
                                </td>
                            </tr>
                        </table>
                        <p style="margin-top: 6px;">are met.</p>
                        <table class="tap" style="font-size: 13px; margin-bottom: 12px;">
                            <tr>
                                <td class="top" style="width: 32%;">Send certification logo as jpg to company:</td>
                                <td>
                                    <t t-out="'☒' if o.ct_send_logo == 'yes' else '☐'"/> yes<br/>
                                    <t t-out="'☒' if o.ct_send_logo == 'no' else '☐'"/> no<br/>
                                    <t t-out="'☒' if o.ct_send_logo == 'undefined' else '☐'"/> undefined
                                </td>
                            </tr>
                        </table>
                        <p class="note"><sup>1)</sup> When specifying the certified company, the company name registered under commercial law, address, zip code and town must be stated. If only part of a company is included in the certification system, the units to be certified must be listed under the company name. In the case of several branches or locations, please state separately which are to be included in the certificate.</p>
                        <p class="note"><sup>2)</sup> The scope must reflect the activities (sales, trade, development, manufacturing, assembly, service, etc.) as well as the products or services. It must be suitable to clearly identify, without further insight into the certification documents, the activities and the field of employment of the organization.</p>
                        <h3><b>Statement of applicability (SoA)</b> <span style="font-weight: normal; font-size: 12px;">only required for certifications according to ISO 27001</span></h3>
                        <table class="tap" style="font-size: 13px;">
                            <tr>
                                <td style="width: 50%; height: 26px;"><b>Filename, version:</b> <t t-out="o.ct_soa_file or 'XXX'"/></td>
                                <td><b>Date:</b> <t t-out="o.ct_soa_date and o.ct_soa_date.strftime('%d.%m.%Y') or 'dd.mm.yyyy'"/></td>
                            </tr>
                        </table>
                        <h3><b>Operator number (BNetzA)</b> <span style="font-weight: normal; font-size: 12px;">only required for certifications according to IT-SiKat</span></h3>
                        <table class="tap" style="font-size: 13px;">
                            <tr>
                                <td style="width: 50%; height: 26px;"><b>Branch Electricity:</b> <t t-out="o.ct_branch_electricity or 'XXX'"/></td>
                                <td><b>Branch Gas:</b> <t t-out="o.ct_branch_gas or 'XXX'"/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <div class="footer">
                    <t t-call="tuv_audit_reports.form_page_footer"/>
                </div>
            </t>
        </t>
    </template>

</odoo>
