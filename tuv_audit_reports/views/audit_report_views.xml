<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Clicking a card runs action_open_form, which opens that card's predefined form. -->
    <record id="tuv_audit_report_view_kanban" model="ir.ui.view">
        <field name="name">tuv.audit.report.kanban</field>
        <field name="model">tuv.audit.report</field>
        <field name="arch" type="xml">
            <kanban create="0" delete="0" action="action_open_form" type="object"
                default_group_by="accreditation" group_create="0" group_delete="0" group_edit="0"
                records_draggable="0">
                <field name="accreditation"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong class="fs-5"><field name="name"/></strong>
                                <div class="text-muted"><field name="code"/></div>
                                <div class="o_text_overflow"><field name="subtitle"/></div>
                            </div>
                            <div class="col-4 text-end">
                                <span class="badge text-bg-primary" title="Revision">
                                    Rev. <field name="revision"/></span>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <field name="document_name"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="tuv_audit_report_view_search" model="ir.ui.view">
        <field name="name">tuv.audit.report.search</field>
        <field name="model">tuv.audit.report</field>
        <field name="arch" type="xml">
            <search string="Reports">
                <field name="name"/>
                <field name="code"/>
                <filter name="tuv_austria" string="TÜV Austria" domain="[('accreditation', '=', 'tuv_austria')]"/>
                <filter name="esyd" string="ESYD" domain="[('accreditation', '=', 'esyd')]"/>
                <filter name="pnac" string="PNAC" domain="[('accreditation', '=', 'pnac')]"/>
                <filter name="saac" string="SAAC" domain="[('accreditation', '=', 'saac')]"/>
                <group>
                    <filter name="group_accreditation" string="Accreditation" context="{'group_by': 'accreditation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tuv_audit_report_action" model="ir.actions.act_window">
        <field name="name">Reports</field>
        <field name="res_model">tuv.audit.report</field>
        <field name="view_mode">kanban</field>
    </record>

</odoo>
