<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- AQG audit questionnaires / checklists (ESYD, PNAC, SAAC): the blocks under sections 1
         and 2 (sections 1 and 2 are the shared ap_* fields). The fixed texts of the Word forms
         (mandatory document lists, audit objectives of PNAC...) print in the PDF.
         tools/gen_standalone_views.py copies these blocks to the standalone form. -->

    <!-- ESYD - Audit Questionnaire ISO 27001:2022 -->
    <record id="project_block_aqg_esyd_27001" model="ir.ui.view">
        <field name="name">project.project.form.tuv.block.aqg_esyd_27001</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tuv_audit_reports.edit_project_audit_plan_tab"/>
        <field name="arch" type="xml">
            <div name="tuv_form_blocks" position="inside">
                <div name="tuv_block_aqg_esyd_27001" invisible="audit_report_key != 'aqg_esyd_27001'">
                    <separator string="Audit Objective"/>
                    <field name="aqg_esyd_27001_objective_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="box_1" string="Ticked" widget="boolean_toggle"/>
                            <field name="label" string="Audit Objective"/>
                        </list>
                    </field>
                    <separator string="3. Legislative Requirements"/>
                    <field name="aqg_esyd_27001_legal_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="label" string="Requirement"/>
                            <field name="text_1" string="Entry"/>
                        </list>
                    </field>
                    <separator string="Standard Requirements Audited"/>
                    <field name="aqg_esyd_27001_clause_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" limit="100">
                            <field name="sequence" column_invisible="1"/>
                            <field name="section"/>
                            <field name="label" string="Requirement"/>
                            <field name="box_1" string="Audited"/>
                        </list>
                    </field>
                    <separator string="Clauses 4 - 10 and Annex A: Objective Evidences"/>
                    <div class="text-muted small mb-1">
                        The mandatory documents of each clause print in the PDF, the objective
                        evidences under them.
                    </div>
                    <field name="aqg_esyd_27001_evidence_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0" limit="120">
                            <field name="sequence" column_invisible="1"/>
                            <field name="section"/>
                            <field name="ref" string="Clause / Control"/>
                            <field name="text_1" string="Objective Evidences"/>
                        </list>
                    </field>
                    <separator string="Auditor Notes"/>
                    <field name="aqg_esyd_27001_notes" nolabel="1"/>
                    <separator string="List of Improvement Hints"/>
                    <div class="text-muted small mb-1">One hint per line.</div>
                    <field name="aqg_esyd_27001_hints" nolabel="1"/>
                    <separator string="List of Positive Findings"/>
                    <div class="text-muted small mb-1">One finding per line.</div>
                    <field name="aqg_esyd_27001_findings" nolabel="1"/>
                </div>
            </div>
        </field>
    </record>

