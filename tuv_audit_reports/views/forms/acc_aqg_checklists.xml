    <!-- SAAC - Audit checklist ISO 9001 (FM-BA-ZET-MS-All-009b-AQG) -->
    <record id="project_block_aqg_saac_9001" model="ir.ui.view">
        <field name="name">project.project.form.tuv.block.aqg_saac_9001</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tuv_audit_reports.edit_project_audit_plan_tab"/>
        <field name="arch" type="xml">
            <div name="tuv_form_blocks" position="inside">
                <div name="tuv_block_aqg_saac_9001" invisible="audit_report_key != 'aqg_saac_9001'">
                    <separator string="Process-oriented Audit: Standard Elements per Audit Type"/>
                    <div class="text-muted small mb-1">
                        Tick the audit types each element was audited in. "Mandatory for" lists the
                        audit types the Word form marks in grey: those must be audited every time;
                        the others are split so that all are assessed at least once over the two
                        surveillance audits. The list of required documents prints in the PDF.
                    </div>
                    <field name="aqg_saac_9001_element_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="label" string="Element"/>
                            <field name="mandatory_for"/>
                            <field name="box_1" string="CA/RA"/>
                            <field name="box_2" string="1. SA"/>
                            <field name="box_3" string="2. SA"/>
                        </list>
                    </field>
                    <separator string="Notes of Auditor(s)"/>
                    <field name="aqg_saac_9001_notes" nolabel="1"/>
                </div>
            </div>
        </field>
    </record>

</odoo>
