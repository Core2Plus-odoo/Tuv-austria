<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Certificate Text (FM-TAGMBH-MSZ-038): the block under sections 1 and 2.
         tools/gen_standalone_views.py copies it to the standalone form. -->
    <record id="project_block_audit_certificate_text" model="ir.ui.view">
        <field name="name">project.project.form.tuv.block.audit_certificate_text</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tuv_audit_reports.edit_project_audit_plan_tab"/>
        <field name="arch" type="xml">
            <div name="tuv_form_blocks" position="inside">
                <div name="tuv_block_audit_certificate_text" invisible="audit_report_key != 'certificate_text'">
                    <group string="Contact">
                        <group>
                            <field name="ct_contact_person"/>
                            <field name="ct_phone"/>
                        </group>
                        <group>
                            <field name="ct_fax"/>
                            <field name="ct_email" widget="email"/>
                        </group>
                    </group>

                    <separator string="Certificate Issue"/>
                    <group>
                        <group string="Desired Certificate Format">
                            <field name="ct_format_a3"/>
                            <field name="ct_format_a4"/>
                            <field name="ct_format_pdf"/>
                        </group>
                        <group>
                            <field name="ct_languages"/>
                            <field name="ct_certificates_per_language"/>
                            <field name="ct_additional_costs"/>
                        </group>
                    </group>
                    <div class="text-muted small mb-2">
                        Two certificates are included in the price for every certification and every
                        recertification. The agreement in the offer is binding. Please enclose a translation
                        in all desired languages of the scope of certification. The certificates can only be
                        delivered after the certification contract is signed.
                    </div>

                    <separator string="Sub Certificates (optional)"/>
                    <div class="text-muted small mb-1">
                        Complete address and the scope of the certification for every site.
                    </div>
                    <group>
                        <field name="ct_sub_certificate_1"/>
                        <field name="ct_sub_certificate_2"/>
                        <field name="ct_sub_certificate_3"/>
                        <field name="ct_sub_certificate_4"/>
                    </group>

                    <separator string="Certificate Wording"/>
                    <group>
                        <field name="ct_company_text"/>
                        <field name="ct_scope_text"/>
                    </group>
                    <group string="It has been proven that the requirements of the standard ... are met">
                        <group>
                            <field name="ct_std_iso9001"/>
                            <field name="ct_std_iso14001"/>
                            <field name="ct_std_iso45001"/>
                            <field name="ct_std_iso29990"/>
                            <field name="ct_std_scc"/>
                            <field name="ct_std_scp"/>
                        </group>
                        <group>
                            <field name="ct_std_iso22000"/>
                            <field name="ct_std_iso50001"/>
                            <field name="ct_std_iso27001"/>
                            <field name="ct_std_iso20000"/>
                            <field name="ct_std_other_1"/>
                            <field name="ct_std_other_2"/>
                        </group>
                    </group>
                    <group>
                        <field name="ct_send_logo" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <group>
                        <group string="Statement of Applicability (ISO 27001 only)">
                            <field name="ct_soa_file"/>
                            <field name="ct_soa_date"/>
                        </group>
                        <group string="Operator Number BNetzA (IT-SiKat only)">
                            <field name="ct_branch_electricity"/>
                            <field name="ct_branch_gas"/>
                        </group>
                    </group>
                </div>
            </div>
        </field>
    </record>

</odoo>
