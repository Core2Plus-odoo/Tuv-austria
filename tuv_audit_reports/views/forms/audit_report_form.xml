<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit Report (FM-TAGMBH-MSZ-003): the block under sections 1 and 2, in the order of the
         form. tools/gen_standalone_views.py copies it to the standalone form. -->
    <record id="project_block_audit_report_form" model="ir.ui.view">
        <field name="name">project.project.form.tuv.block.audit_report_form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tuv_audit_reports.edit_project_audit_plan_tab"/>
        <field name="arch" type="xml">
            <div name="tuv_form_blocks" position="inside">
                <div name="tuv_block_audit_report_form" invisible="audit_report_key != 'audit_report'">
                    <div class="text-muted small mb-2">
                        3. Audit objectives and the rating scale print as in the form. Rating: 1 fully compliant,
                        2 opportunity for improvement, 3 minor NC, 4 major NC (documents), 5 major NC (re-audit), NA.
                    </div>

                    <separator string="4. Detailed Result of the Audit - Stage 1"/>
                    <group>
                        <field name="ar_stage1_result" placeholder="Statement on the summary result of stage 1"/>
                    </group>
                    <field name="ar_stage1_row_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="label" string="Requirement" width="220px"/>
                            <field name="std1"/>
                            <field name="std2"/>
                            <field name="std3"/>
                            <field name="std4"/>
                            <field name="std5"/>
                        </list>
                    </field>
                    <label for="ar_deviation_ids" string="List of Deviations for Stage 1 (close within 6 months)" class="fw-bold"/>
                    <field name="ar_deviation_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kind" column_invisible="1"/>
                            <field name="number"/>
                            <field name="description"/>
                            <field name="standard"/>
                            <field name="clause"/>
                            <field name="corrective_action" string="Corrective Action"/>
                            <field name="evidence"/>
                            <field name="rating" string="Rating of Corrective Action"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="ar_dev_place_date"/>
                        </group>
                        <group>
                            <field name="ar_dev_completion_place_date"/>
                        </group>
                    </group>

                    <separator string="Audit Conclusions"/>
                    <field name="ar_conclusion_row_ids">
                        <list editable="bottom" create="0" delete="0" limit="200"
                            decoration-bf="kind in ('head', 'sub')" decoration-muted="kind in ('head', 'sub')">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" width="420px"/>
                            <field name="audited" invisible="kind not in ('item', 'location')"/>
                            <field name="remote" invisible="kind != 'location'"/>
                            <field name="rating" invisible="kind != 'item'"/>
                            <field name="comment" string="Conclusion / Comment / Evidence / Address"
                                invisible="kind in ('head', 'sub', 'item')"/>
                        </list>
                    </field>

                    <separator string="Inspected Requirements of the Standard According to the Audit Plan"/>
                    <field name="ar_iso27001_row_ids">
                        <list editable="bottom" create="0" delete="0" decoration-bf="kind == 'head'">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" string="Annex A of ISO 27001:2022"/>
                            <field name="ca" invisible="kind == 'head'"/>
                            <field name="sa1" invisible="kind == 'head'"/>
                            <field name="sa2" invisible="kind == 'head'"/>
                        </list>
                    </field>
                    <field name="ar_iso27701_row_ids">
                        <list editable="bottom" create="0" delete="0" decoration-bf="kind == 'head'">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" string="Annex A and Annex B of ISO 27701:2019"/>
                            <field name="ca" invisible="kind == 'head'"/>
                            <field name="sa1" invisible="kind == 'head'"/>
                            <field name="sa2" invisible="kind == 'head'"/>
                        </list>
                    </field>
                    <field name="ar_sikat_row_ids">
                        <list editable="bottom" create="0" delete="0" decoration-bf="kind == 'head'">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" string="Critical processes, systems, and applications (IT-SiKat)"/>
                            <field name="ca" invisible="kind == 'head'"/>
                            <field name="sa1" invisible="kind == 'head'"/>
                            <field name="sa2" invisible="kind == 'head'"/>
                        </list>
                    </field>
                    <field name="ar_iso20000_row_ids">
                        <list editable="bottom" create="0" delete="0" decoration-bf="kind == 'head'">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" string="Process oriented audit according to ISO 20000-1"/>
                            <field name="audited" invisible="kind == 'head'"/>
                        </list>
                    </field>
                    <field name="ar_iso22301_row_ids">
                        <list editable="bottom" create="0" delete="0" decoration-bf="kind == 'head'">
                            <field name="kind" column_invisible="1"/>
                            <field name="label" string="Process oriented audit according to ISO 22301"/>
                            <field name="audited" invisible="kind == 'head'"/>
                        </list>
                    </field>

                    <separator string="List of Positive Findings"/>
                    <field name="ar_positive_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kind" column_invisible="1"/>
                            <field name="number"/>
                            <field name="description" string="Description"/>
                        </list>
                    </field>

                    <separator string="List of Findings / Nonconformities"/>
                    <label for="ar_nc_last_ids" string="Nonconformities from the last audit" class="fw-bold"/>
                    <field name="ar_nc_last_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kind" column_invisible="1"/>
                            <field name="number"/>
                            <field name="standard"/>
                            <field name="clause"/>
                            <field name="description"/>
                            <field name="rating"/>
                            <field name="corrective_action"/>
                            <field name="completion_date"/>
                            <field name="evidence"/>
                            <field name="verification"/>
                        </list>
                    </field>
                    <label for="ar_nc_this_ids" string="Findings / nonconformities from this audit (from the NC register)" class="fw-bold"/>
                    <field name="ar_nc_this_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="kind" column_invisible="1"/>
                            <field name="number"/>
                            <field name="standard"/>
                            <field name="clause"/>
                            <field name="description"/>
                            <field name="rating"/>
                            <field name="corrective_action"/>
                            <field name="completion_date"/>
                            <field name="evidence"/>
                            <field name="verification"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="ar_nc_place_date"/>
                        </group>
                        <group>
                            <field name="ar_nc_completion_place_date"/>
                        </group>
                    </group>

                    <separator string="5. Recommendation of the Audit Team"/>
                    <group>
                        <group>
                            <field name="ar_scope_appropriate" widget="radio" options="{'horizontal': true}"/>
                            <field name="ar_objectives_fulfilled" widget="radio" options="{'horizontal': true}"/>
                            <field name="ar_rec_standards"/>
                        </group>
                        <group>
                            <field name="ar_rec_suggestion" widget="radio"/>
                            <field name="ar_rec_after" widget="radio"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="ar_place"/>
                            <field name="ar_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Lead Auditor">
                            <field name="ap_lead_auditor_id" readonly="1" string="Name"/>
                            <field name="ar_lead_signature" widget="signature" string="Signature"/>
                        </group>
                        <group string="Auditor(s)">
                            <field name="ap_auditor_names" string="Name(s)"/>
                            <field name="ar_auditor_signature" widget="signature" string="Signature"/>
                        </group>
                    </group>
                </div>
            </div>
        </field>
    </record>

</odoo>
