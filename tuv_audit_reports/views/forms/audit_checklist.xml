                        </list>
                    </field>
                    <field name="cl_pnaccombined_line_ids" invisible="audit_report_key != 'checklist_pnaccombined'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="group"/>
                            <field name="clause"/>
                            <field name="mandatory_for"/>
                            <field name="chk_ca"/>
                            <field name="chk_sa1"/>
                            <field name="chk_sa2"/>
                        </list>
                    </field>

                    <separator string="Notes of Auditor(s)"/>
                    <field name="cl_iso9001_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso9001'"/>
                    <field name="cl_iso45001_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso45001'"/>
                    <field name="cl_iso14001_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso14001'"/>
                    <field name="cl_iso50001_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso50001'"/>
                    <field name="cl_iso13485_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso13485'"/>
                    <field name="cl_iso20000_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso20000'"/>
                    <field name="cl_iso37301_notes" nolabel="1" invisible="audit_report_key != 'checklist_iso37301'"/>
                    <field name="cl_combined_notes" nolabel="1" invisible="audit_report_key != 'checklist_combined'"/>
                    <field name="cl_pnac9001_notes" nolabel="1" invisible="audit_report_key != 'checklist_pnac9001'"/>
                    <field name="cl_pnac14001_notes" nolabel="1" invisible="audit_report_key != 'checklist_pnac14001'"/>
                    <field name="cl_pnac45001_notes" nolabel="1" invisible="audit_report_key != 'checklist_pnac45001'"/>
                    <field name="cl_pnaccombined_notes" nolabel="1" invisible="audit_report_key != 'checklist_pnaccombined'"/>
                </div>
            </div>
        </field>
    </record>

</odoo>
