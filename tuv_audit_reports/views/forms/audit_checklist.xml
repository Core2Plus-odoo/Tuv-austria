                            <field name="mandatory_for"/>
                            <field name="chk_ca"/>
                            <field name="chk_sa1"/>
                            <field name="chk_sa2"/>
                        </list>
                    </field>
                    <field name="cl_combined_line_ids" invisible="audit_report_key != 'checklist_combined'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="group"/>
                            <field name="clause"/>
                            <field name="mandatory_for"/>
                            <field name="chk_ca"/>
                            <field name="chk_sa1"/>
