                        </list>
                    </field>
                    <field name="cl_pnac45001_line_ids" invisible="audit_report_key != 'checklist_pnac45001'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="clause"/>
