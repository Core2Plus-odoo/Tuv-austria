                        </list>
                    </field>

                    <field name="cl_pnac9001_line_ids" invisible="audit_report_key != 'checklist_pnac9001'">
                        <list editable="bottom" create="0" delete="0">
                            <field name="sequence" column_invisible="1"/>
                            <field name="clause"/>
                            <field name="mandatory_for"/>
                            <field name="chk_ca"/>
                            <field name="chk_sa1"/>
