<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Audit Checklist ISO 27001 (FM-TAGMBH-MSZ-023, Excel): the rows of the sheet, chapters
         in bold, the auditor's rate / evidence / findings / notes editable.
         tools/gen_standalone_views.py copies it to the standalone form. -->
    <record id="project_block_audit_checklist_isms" model="ir.ui.view">
        <field name="name">project.project.form.tuv.block.audit_checklist_isms</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="tuv_audit_reports.edit_project_audit_plan_tab"/>
        <field name="arch" type="xml">
            <div name="tuv_form_blocks" position="inside">
                <div name="tuv_block_audit_checklist_isms" invisible="audit_report_key != 'checklist_iso27001'">
                    <separator string="Audit Checklist - Information Security Management System"/>
                    <div class="text-muted small mb-1">
                        Template to ISO/IEC 27001:2022 - 12.08.2025. Rate: FC / IM / PC / NC.
                        "(St.1)" under Sel. marks the requirements to audit in stage 1.
                    </div>
                    <field name="ic_line_ids">
                        <list editable="bottom" create="0" delete="0" limit="100"
                            decoration-bf="is_chapter" decoration-muted="is_chapter">
                            <field name="sequence" column_invisible="1"/>
                            <field name="is_chapter" column_invisible="1"/>
                            <field name="sel"/>
                            <field name="ref"/>
                            <field name="requirement" width="420px"/>
                            <field name="rate" invisible="is_chapter"
                                decoration-success="rate == 'FC'" decoration-warning="rate in ('IM', 'PC')"
                                decoration-danger="rate == 'NC'"/>
                            <field name="evidence" invisible="is_chapter"/>
                            <field name="findings" invisible="is_chapter"/>
                            <field name="comments" invisible="is_chapter"/>
                            <field name="audit_notes" invisible="is_chapter"/>
                            <field name="capabilities" optional="hide" invisible="is_chapter"/>
                        </list>
                    </field>
                </div>
            </div>
        </field>
    </record>

</odoo>
