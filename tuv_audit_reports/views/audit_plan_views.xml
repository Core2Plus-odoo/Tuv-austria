<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The standalone form a Reports card opens: one predefined tuv.audit.plan record per card.
         Sections 1 and 2 are the same as on the project's Audit Plan tab (views/project_views.xml);
         each form's block is added from views/standalone_blocks.xml, generated by
         tools/gen_standalone_views.py from views/forms/*.xml. Keep the two in step. -->
    <record id="tuv_audit_plan_view_form" model="ir.ui.view">
        <field name="name">tuv.audit.plan.form</field>
        <field name="model">tuv.audit.plan</field>
        <field name="arch" type="xml">
            <form string="Audit Form" create="0" delete="0" duplicate="0">
                <sheet>
                    <div class="oe_title">
                        <div class="text-muted">
                            <field name="form_subtitle" readonly="1" class="d-inline"/>
                            <span class="ms-2 small"><field name="form_reference" readonly="1" class="d-inline"/></span>
                        </div>
                        <h1><field name="name"/></h1>
                    </div>
                    <field name="audit_report_key" invisible="1"/>
                    <field name="audit_report_uses_info" invisible="1"/>

                    <div name="tuv_audit_info" invisible="not audit_report_uses_info">
                        <!-- 1. Company information -->
                        <separator string="1. Company Information"/>
                        <group>
                            <group>
                                <field name="ap_partner_id" string="Company Name"/>
                                <field name="ap_company_address"/>
                                <field name="ap_other_sites"/>
                            </group>
                            <group>
                                <field name="ap_representative" string="Company Representative"/>
                                <field name="ap_representative_email" widget="email"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <group>
                            <field name="ap_certificate_scope" string="Scope of Certification / Certificate Text"/>
                        </group>

                        <!-- 2. Audit information -->
                        <separator string="2. Audit Information"/>
                        <group>
                            <group string="Audit Date">
                                <field name="ap_audit_date_stage1" string="Stage 1"/>
                                <field name="ap_audit_date_stage2" string="Stage 2"/>
                                <field name="ap_audit_date_until"/>
                                <field name="ap_remote" widget="radio" options="{'horizontal': true}"/>
                            </group>
                            <group string="Audit Method">
                                <field name="ap_audit_method"/>
                                <field name="ap_audit_method_other"
                                    invisible="ap_audit_method not in ('others', 'self_definition')"/>
                                <field name="ap_employee_count"/>
                                <field name="ap_employee_scope_count"/>
                                <field name="ap_audit_duration_hours"/>
                            </group>
                        </group>
                        <label for="ap_standard_line_ids" string="Audit Standard(s) (max. 5)" class="fw-bold"/>
                        <field name="ap_standard_line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="standard"/>
                                <field name="audit_type"/>
                                <field name="audit_type_other"/>
                                <field name="registration_no"/>
                            </list>
                        </field>
                        <group>
                            <group string="Scope">
                                <field name="ap_scope_change" widget="radio"/>
                                <field name="ap_eac_scope"/>
                            </group>
                            <group string="Codes">
                                <field name="ap_nace_code"/>
                                <field name="ap_category"/>
                            </group>
                        </group>
                        <group string="Audit Team">
                            <field name="ap_lead_auditor_id" string="Lead Auditor"/>
                        </group>
                        <field name="ap_team_line_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="partner_id"/>
                                <field name="role"/>
                            </list>
                        </field>
                    </div>

                    <!-- each form's own block: views/standalone_blocks.xml -->
                    <div name="tuv_form_blocks"/>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
