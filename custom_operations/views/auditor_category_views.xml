<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_auditor_category_list" model="ir.ui.view">
        <field name="name">auditor.category.list</field>
        <field name="model">auditor.category</field>
        <field name="arch" type="xml">
            <list string="Auditor Category" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_auditor_category" model="ir.actions.act_window">
        <field name="name">Auditor Category</field>
        <field name="res_model">auditor.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_auditor_category"
        action="action_auditor_category"
        name="Auditor Category"
        parent="contacts.res_partner_menu_config"
        sequence="9"/>

</odoo>
