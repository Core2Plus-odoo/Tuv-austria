<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: once the counter is running an upgrade must not reset it -->
    <data noupdate="1">

        <!-- The document number the order carries through the whole flow. It is
             drawn once, when sales takes the offer application. The prefix and the
             padding can be changed by the client in
             Settings > Technical > Sequences without touching the code. -->
        <record id="seq_tuv_document" model="ir.sequence">
            <field name="name">TUV Austria Document Number</field>
            <field name="code">tuv.austria.document</field>
            <field name="prefix">TUV-</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">standard</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
