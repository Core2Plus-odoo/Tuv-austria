<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Daily: every issued certificate has to be in the register -->
        <record id="ir_cron_certificate_register" model="ir.cron">
            <field name="name">TUV: Certificate Register Completeness Check</field>
            <field name="model_id" ref="model_tuv_certificate_register"/>
            <field name="state">code</field>
            <field name="code">model._cron_register_completeness()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
