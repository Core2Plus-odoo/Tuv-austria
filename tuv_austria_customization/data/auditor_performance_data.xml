<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Every January: draft annual reviews for the year that just ended -->
        <record id="ir_cron_auditor_annual_review" model="ir.cron">
            <field name="name">TUV: Generate Annual Auditor Reviews</field>
            <field name="model_id" ref="model_tuv_auditor_review"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_previous_year()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="nextcall" eval="(DateTime.today().replace(month=1, day=1, hour=6, minute=0, second=0) + relativedelta(years=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
