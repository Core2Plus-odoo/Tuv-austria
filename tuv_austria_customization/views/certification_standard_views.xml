<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_certification_standard_list" model="ir.ui.view">
        <field name="name">certification.standard.list</field>
        <field name="model">certification.standard</field>
        <field name="arch" type="xml">
            <list string="Certification Standard" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_certification_standard" model="ir.actions.act_window">
        <field name="name">Certification Standards</field>
        <field name="res_model">certification.standard</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_certification_standard"
        action="action_certification_standard"
        name="Certification Standards"
        parent="contacts.res_partner_menu_config"
        sequence="8"/>

</odoo>
