<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_tuv_austria_customization" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.operations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="before">
                <field name="certificate_no" invisible="1"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="string">Client / Certificate Holder</attribute>
                <attribute name="domain">[('contact_type', '=', 'client')]</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 0, 'show_vat': False}</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="distinctive_title"/>
                <span class="o_form_label o_td_label" name="partner_address_name">Address</span>
                <div class="o_address_format">
                    <field name="partner_street" placeholder="Street..." class="o_address_street"/>
                    <field name="partner_street2" placeholder="Street 2..." class="o_address_street"/>
                    <field name="partner_city" placeholder="City" class="o_address_city"/>
                    <field name="partner_state_id" placeholder="State" class="o_address_state"
                        options="{'no_open': True, 'no_quick_create': True}"/>
                    <field name="partner_zip" placeholder="ZIP" class="o_address_zip"/>
                    <field name="partner_country_id" placeholder="Country" class="o_address_country"
                        options="{'no_open': True, 'no_create': True}"/>
                </div>
                <field name="partner_phone"/>
                <field name="partner_email"/>
                <field name="telefax"/>
                <field name="website" widget="url"/>
                <field name="vat"/>
            </field>

            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="document_type"/>
                <field name="contract_completed" invisible="1"/>
                <field name="contract_status" widget="badge"
                    decoration-success="contract_completed"
                    invisible="not contract_completed"/>
            </xpath>

            <!-- The order runs on its document type, not on the quotation states, so the
                 statusbar shows the document types and one button per type moves it there.
                 Send / Preview / Cancel are not part of that flow. -->
            <field name="state" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//header/button[1]" position="before">
                <!-- The flow, one step at a time: the review form goes to the planning
                     team first, and only their approval opens the sales documents. -->
                <button name="action_document_review_form" type="object"
                    string="Review Form" class="btn-primary" data-hotkey="1"
                    invisible="document_type"/>
                <button name="action_submit_to_planning" type="object"
                    string="Submit to Planning Team" class="btn-primary" data-hotkey="s"
                    invisible="document_type != 'review_form' or review_state != 'draft'"/>
                <button name="action_approve_review" type="object"
                    string="Approve Review" class="btn-primary" data-hotkey="a"
                    groups="tuv_austria_customization.group_planning_team,base.group_system"
                    invisible="review_state != 'waiting_review'"/>
                <button name="action_reject_review" type="object"
                    string="Send Back to Sales" data-hotkey="r"
                    groups="tuv_austria_customization.group_planning_team,base.group_system"
                    invisible="review_state != 'waiting_review'"/>
                <button name="action_document_offer_application" type="object"
                    string="Offer Application" class="btn-primary" data-hotkey="2"
                    invisible="document_type != 'review_form' or review_state != 'review_approved'"/>
                <button name="action_document_proposal_form" type="object"
                    string="Proposal Form" data-hotkey="3"
                    invisible="document_type != 'offer_application'"/>
                <button name="action_document_contract_form" type="object"
                    string="TAC-TAH-Contract" data-hotkey="4"
                    invisible="document_type not in ('proposal_form', 'pnac_contract')"/>
                <button name="action_document_pnac_contract" type="object"
                    string="PNAC-Contract" data-hotkey="5"
                    invisible="document_type not in ('proposal_form', 'contract_form')"/>
                <button name="action_send_contract_to_planning" type="object"
                    string="Send Contract to Planning" class="btn-primary" data-hotkey="c"
                    invisible="document_type not in ('contract_form', 'pnac_contract')"/>
            </xpath>
            <field name="state" position="after">
                <!-- One bar for the whole flow; statusbar_visible keeps it short, so
                     only the stage the order is actually in is drawn. -->
                <field name="flow_state" widget="statusbar" statusbar_visible="_"/>
                <field name="review_state" invisible="1"/>
                <field name="review_locked" invisible="1"/>
                <field name="document_stage" invisible="1"/>
            </field>

            <xpath expr="//header/button[@id='quotation_send_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma_primary']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='send_proforma']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@id='quotation_send']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_preview_sale_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='sale.action_report_saleorder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Confirmation is not a step the user takes any more: handing over a
                 contract confirms the order (see _handle_contract_document). -->
            <xpath expr="(//header/button[@name='action_confirm'])[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="(//header/button[@name='action_confirm'])[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//button[@name='action_view_project_ids']" position="replace">
                <button
                    name="action_view_project_ids"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-puzzle-piece"
                    invisible="not show_project_button"
                    groups="project.group_project_user"
                >
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
                <button
                    name="action_view_task_ids"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    invisible="not tasks_count"
                    groups="project.group_project_user"
                >
                    <field name="tasks_count" widget="statinfo" string="Tasks"/>
                </button>
            </xpath>

            <group name="sale_header" position="after">
                <group name="group_certification_details" string="Certification Details" invisible="1">
                    <group name="group_certification_details_left">
                        <field name="certification_standard"/>
                        <field name="ea_code_ids" widget="many2many_tags"/>
                        <field name="scope_of_certification"/>
                        <field name="issue_date" options="{'numeric': true}"/>
                        <field name="expiry_date" options="{'numeric': true}"/>
                        <field name="next_surveillance" options="{'numeric': true}"/>
                    </group>
                    <group name="group_certification_details_right">
                        <field name="audit_type"/>
                        <field name="lead_auditor"/>
                        <field name="certificate_status"/>
                        <field name="office_issued_from"/>
                        <field name="notes"/>
                    </group>
                </group>
            </group>

            <!-- Every document of the flow gets its own tab; a tab appears as soon
                 as the order reaches that step and then stays. -->
            <xpath expr="//notebook" position="inside">
                <page name="review_form_page" string="Review Form" invisible="document_stage &lt; 1">
                    <group name="group_review_form" string="Review Form"
                        invisible="document_stage &lt; 1" readonly="review_locked">
                        <group name="group_review_competence"
                            string="Competence Evaluation &amp; Impartiality Check">
                            <field name="rf_competent" widget="radio" options="{'horizontal': True}"/>
                            <field name="rf_info_sufficient" widget="radio" options="{'horizontal': True}"/>
                            <field name="rf_impartiality_risk" widget="radio" options="{'horizontal': True}"/>
                            <field name="rf_specify"/>
                        </group>
                        <group name="group_review_client" string="Audit Type &amp; Client Information">
                            <field name="rf_audit_type" widget="radio" options="{'horizontal': True}"/>
                            <field name="rf_scope"/>
                            <field name="rf_iaf_code"/>
                            <field name="rf_standards"/>
                        </group>
                        <group name="group_review_history"
                            string="Certification History (for recertification only)">
                            <field name="rf_certified_since"/>
                            <field name="rf_iso_9001"/>
                            <field name="rf_iso_14001"/>
                            <field name="rf_iso_45001"/>
                            <field name="rf_iso_22000"/>
                            <field name="rf_others"/>
                            <field name="rf_others_text" invisible="not rf_others"/>
                        </group>
                        <group name="group_review_declarations" string="Previous Cycle">
                            <field name="rf_docs_reviewed"/>
                            <field name="rf_reports_evaluated"/>
                        </group>
                        <group name="group_review_ic" string="Initial Certification">
                            <field name="rf_ic_dates"/>
                            <field name="rf_ic_report_reviewed"/>
                            <field name="rf_ic_nc"/>
                            <field name="rf_ic_nc_status"/>
                        </group>
                        <group name="group_review_s1" string="Surveillance 01">
                            <field name="rf_s1_dates"/>
                            <field name="rf_s1_report_reviewed"/>
                            <field name="rf_s1_nc"/>
                            <field name="rf_s1_nc_status"/>
                        </group>
                        <group name="group_review_s2" string="Surveillance 02">
                            <field name="rf_s2_dates"/>
                            <field name="rf_s2_report_reviewed"/>
                            <field name="rf_s2_nc"/>
                            <field name="rf_s2_nc_status"/>
                        </group>
                        <group name="group_review_outcome" string="Review Outcome">
                            <field name="rf_outcome" widget="radio"/>
                            <field name="rf_reviewer_name"/>
                            <field name="rf_date"/>
                            <field name="rf_signature_filename" invisible="1"/>
                            <field name="rf_signature" widget="image"
                                filename="rf_signature_filename" options="{'size': [200, 90]}"/>
                        </group>
                        <group name="group_review_trace" string="Review Trace">
                            <field name="review_submitted_by" readonly="1"/>
                            <field name="review_submitted_on" readonly="1"/>
                            <field name="review_approved_by" readonly="1"/>
                            <field name="review_approved_on" readonly="1"/>
                        </group>
                    </group>
                </page>
                <page name="application_form_page" string="Application Form" invisible="document_stage &lt; 2">
                    <group name="group_application_form" string="Application Form"
                        invisible="document_stage &lt; 2">
                        <group name="group_application_form_left">
                            <field name="audit_site"/>
                            <field name="other_facilities"/>
                            <field name="sites_to_be_audited"/>
                            <field name="company_representative"/>
                            <field name="management_system_representative"/>
                            <field name="management_system_representative_phone"/>
                            <field name="management_system_representative_email"/>
                            <field name="consultant"/>
                            <field name="consultant_phone"/>
                            <field name="consultant_email"/>
                        </group>
                        <group name="group_application_form_right">

                            <field name="scope_of_activity"/>
                            <field name="critical_processes"/>
                            <field name="legislation_relative"/>
                            <field name="permanent_personnel"/>
                            <field name="temporary_personnel"/>
                            <field name="personnel_on_shifts"/>
                            <field name="number_of_shifts"/>
                            <field name="other_certified_management_system"/>
                            <field name="level_of_integration"/>
                            <field name="license_attachment_filename" invisible="1"/>
                            <field name="license_attachment" filename="license_attachment_filename"/>
                        </group>
                    </group>
                </page>
                <page name="proposal_page" string="Proposal" invisible="document_stage &lt; 3">
                    <group name="group_proposal_form" string="Proposal Form"
                        invisible="document_stage &lt; 3">
                        <group name="group_proposal_form_left">
                            <field name="management_system_name"/>
                        </group>
                        <group name="group_proposal_form_right">
                            <field name="certification_standard"/>
                        </group>
                    </group>
                    <group name="group_proposal_charges" string="Charges"
                        invisible="document_stage &lt; 3">
                        <group name="group_proposal_charges_left">
                            <field name="charge_stage_1_audit"/>
                            <field name="charge_stage_2_audit"/>
                            <field name="travel_boarding_lodging"/>
                        </group>
                        <group name="group_proposal_charges_right">
                            <field name="charge_surveillance_1"/>
                            <field name="charge_surveillance_2"/>
                        </group>
                    </group>
                    <group name="group_proposal_cost" string="Summary of Cost"
                        invisible="document_stage &lt; 3">
                        <group name="group_proposal_cost_amount" string="Certification Fee">
                            <field name="cost_initial_audit"/>
                            <field name="cost_surveillance_1"/>
                            <field name="cost_surveillance_2"/>
                            <field name="cost_total"/>
                        </group>
                        <group name="group_proposal_cost_tax" string="Sales Tax">
                            <field name="cost_tax_label"/>
                            <field name="cost_tax_initial_audit"/>
                            <field name="cost_tax_surveillance_1"/>
                            <field name="cost_tax_surveillance_2"/>
                            <field name="cost_tax_total"/>
                        </group>
                        <group name="group_proposal_cost_grand" string="Total">
                            <field name="cost_grand_initial_audit"/>
                            <field name="cost_grand_surveillance_1"/>
                            <field name="cost_grand_surveillance_2"/>
                            <field name="cost_grand_total"/>
                        </group>
                        <group name="group_proposal_cost_invoicing" string="Invoicing">
                            <field name="proposal_invoicing_terms"/>
                        </group>
                    </group>
                    <group name="group_proposal_prepared_by" string="Prepared By"
                        invisible="document_stage &lt; 3">
                        <group name="group_proposal_prepared_by_left">
                            <field name="prepared_by_name"/>
                            <field name="prepared_by_designation"/>
                            <field name="prepared_by_phone"/>
                            <field name="prepared_by_email"/>
                        </group>
                        <group name="group_proposal_prepared_by_right">
                            <field name="prepared_by_signature_filename" invisible="1"/>
                            <field name="prepared_by_signature" widget="image"
                                filename="prepared_by_signature_filename"
                                options="{'size': [200, 90]}"/>
                        </group>
                    </group>
                </page>
                <page name="contract_page" string="Contract" invisible="document_stage &lt; 4">
                    <group name="group_contract_form" string="Contract Details"
                        invisible="document_stage &lt; 4">
                        <group name="group_contract_form_left">
                            <field name="contract_standards"/>
                            <field name="contract_address_1"/>
                            <field name="contract_address_2"/>
                            <field name="contract_representative"/>
                        </group>
                        <group name="group_contract_form_right">
                            <field name="contract_designation"/>
                            <field name="contract_date"/>
                            <field name="contract_ref"/>
                            <field name="contract_advance_amount"/>
                        </group>
                    </group>
                    <group name="group_contract_services" string="Certification Services Offered"
                        invisible="document_stage &lt; 4">
                        <group name="group_contract_services_1" string="Row 1">
                            <field name="contract_service_1"/>
                            <field name="contract_accreditation_1"/>
                        </group>
                        <group name="group_contract_services_2" string="Row 2">
                            <field name="contract_service_2"/>
                            <field name="contract_accreditation_2"/>
                        </group>
                    </group>
                    <group name="group_contract_charges" string="Contract Charges"
                        invisible="document_stage &lt; 4">
                        <group name="group_contract_charges_y1" string="1st Year Initial Audit (USD)">
                            <field name="contract_fee_y1" string="Standard(s)"/>
                            <field name="contract_mandays_y1" string="*# of Man-days"/>
                            <field name="contract_tax_y1" string="Sales Tax"/>
                            <field name="contract_total_y1" string="Total Payable"/>
                        </group>
                        <group name="group_contract_charges_y2" string="2nd Year Surveillance Audit (USD)">
                            <field name="contract_fee_y2" string="Standard(s)"/>
                            <field name="contract_mandays_y2" string="*# of Man-days"/>
                            <field name="contract_tax_y2" string="Sales Tax"/>
                            <field name="contract_total_y2" string="Total Payable"/>
                        </group>
                        <group name="group_contract_charges_y3" string="3rd Year Surveillance Audit (USD)">
                            <field name="contract_fee_y3" string="Standard(s)"/>
                            <field name="contract_mandays_y3" string="*# of Man-days"/>
                            <field name="contract_tax_y3" string="Sales Tax"/>
                            <field name="contract_total_y3" string="Total Payable"/>
                        </group>
                        <group name="group_contract_charges_tax" string="Tax Row Label">
                            <field name="contract_tax_province"/>
                        </group>
                    </group>
                    <group name="group_pnac_annexure" string="PNAC Annexure 1 - Logos"
                        invisible="document_type != 'pnac_contract'">
                        <group name="group_pnac_logos_left">
                            <field name="pnac_logo_1_filename" invisible="1"/>
                            <field name="pnac_logo_1" widget="image"
                                filename="pnac_logo_1_filename"
                                options="{'size': [200, 90]}"/>
                            <field name="pnac_logo_3_filename" invisible="1"/>
                            <field name="pnac_logo_3" widget="image"
                                filename="pnac_logo_3_filename"
                                options="{'size': [200, 90]}"/>
                        </group>
                        <group name="group_pnac_logos_right">
                            <field name="pnac_logo_2_filename" invisible="1"/>
                            <field name="pnac_logo_2" widget="image"
                                filename="pnac_logo_2_filename"
                                options="{'size': [200, 90]}"/>
                            <field name="pnac_logo_4_filename" invisible="1"/>
                            <field name="pnac_logo_4" widget="image"
                                filename="pnac_logo_4_filename"
                                options="{'size': [200, 90]}"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- The client drives everything from the form sections above, so the
                 standard order lines and Other Info tabs are hidden. -->
            <xpath expr="//page[@name='order_lines']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='other_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <record id="view_sales_order_filter_inherit_tuv_austria_customization" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.custom.operations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <filter name="order_month" position="before">
                <filter name="group_flow_state" string="Flow"
                    context="{'group_by': 'flow_state'}"/>
                <filter name="group_document_type" string="Document Type"
                    context="{'group_by': 'document_type'}"/>
            </filter>
        </field>
    </record>

    <!-- The quotation list drops the stock My Quotations / Quotations / Sales Orders
         filters (and the default one) and filters on the flow instead. -->
    <record id="sale_order_view_search_quotation_inherit_tuv" model="ir.ui.view">
        <field name="name">sale.order.search.quotation.inherit.custom.operations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="arch" type="xml">
            <filter name="my_quotation" position="replace">
                <filter name="flow_draft" string="Draft"
                    domain="[('flow_state', '=', 'draft')]"/>
                <filter name="flow_review_form" string="Review Form"
                    domain="[('flow_state', '=', 'review_form')]"/>
                <filter name="flow_waiting_review" string="Waiting for Review"
                    domain="[('flow_state', '=', 'waiting_review')]"/>
                <filter name="flow_review_approved" string="Review Approved"
                    domain="[('flow_state', '=', 'review_approved')]"/>
                <separator/>
                <filter name="flow_offer_application" string="Offer Application"
                    domain="[('flow_state', '=', 'offer_application')]"/>
                <filter name="flow_proposal_form" string="Proposal Form"
                    domain="[('flow_state', '=', 'proposal_form')]"/>
                <filter name="flow_contract" string="Contract"
                    domain="[('flow_state', '=', 'contract')]"/>
            </filter>
            <filter name="draft" position="replace"/>
            <filter name="sales" position="replace"/>
        </field>
    </record>

    <!-- no filter switched on by default -->
    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>
    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>
    <record id="sale.action_orders" model="ir.actions.act_window">
        <field name="context">{}</field>
    </record>

</odoo>
