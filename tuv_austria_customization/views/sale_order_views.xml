<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_tuv_austria_customization" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.operations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="before">
                <field name="certificate_no" invisible="1"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="string">Client / Certificate Holder</attribute>
                <attribute name="domain">[('contact_type', '=', 'client')]</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 0, 'show_vat': False}</attribute>
            </field>
            <field name="partner_id" position="after">
                <field name="distinctive_title"/>
                <span class="o_form_label o_td_label" name="partner_address_name">Address</span>
                <div class="o_address_format">
                    <field name="partner_street" placeholder="Street..." class="o_address_street"/>
                    <field name="partner_street2" placeholder="Street 2..." class="o_address_street"/>
                    <field name="partner_city" placeholder="City" class="o_address_city"/>
                    <field name="partner_state_id" placeholder="State" class="o_address_state"
                        options="{'no_open': True, 'no_quick_create': True}"/>
                    <field name="partner_zip" placeholder="ZIP" class="o_address_zip"/>
                    <field name="partner_country_id" placeholder="Country" class="o_address_country"
                        options="{'no_open': True, 'no_create': True}"/>
                </div>
                <field name="partner_phone"/>
                <field name="partner_email"/>
                <field name="telefax"/>
                <field name="website" widget="url"/>
                <field name="vat"/>
            </field>

            <xpath expr="//group[@name='order_details']/field[@name='validity_date']" position="before">
                <field name="document_type"/>
            </xpath>

            <xpath expr="//button[@name='action_view_project_ids']" position="replace">
                <button
                    name="action_view_project_ids"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-puzzle-piece"
                    invisible="not show_project_button"
                    groups="project.group_project_user"
                >
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
                <button
                    name="action_view_task_ids"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    invisible="not tasks_count"
                    groups="project.group_project_user"
                >
                    <field name="tasks_count" widget="statinfo" string="Tasks"/>
                </button>
            </xpath>

            <group name="sale_header" position="after">
                <group name="group_certification_details" string="Certification Details" invisible="1">
                    <group name="group_certification_details_left">
                        <field name="certification_standard"/>
                        <field name="ea_code_ids" widget="many2many_tags"/>
                        <field name="scope_of_certification"/>
                        <field name="issue_date" options="{'numeric': true}"/>
                        <field name="expiry_date" options="{'numeric': true}"/>
                        <field name="next_surveillance" options="{'numeric': true}"/>
                    </group>
                    <group name="group_certification_details_right">
                        <field name="audit_type"/>
                        <field name="lead_auditor"/>
                        <field name="certificate_status"/>
                        <field name="office_issued_from"/>
                        <field name="notes"/>
                    </group>
                </group>
                <group name="group_application_form" string="Application Form"
                    invisible="document_type != 'offer_application'">
                    <group name="group_application_form_left">
                        <field name="audit_site"/>
                        <field name="other_facilities"/>
                        <field name="sites_to_be_audited"/>
                        <field name="company_representative"/>
                        <field name="management_system_representative"/>
                        <field name="management_system_representative_phone"/>
                        <field name="management_system_representative_email"/>
                        <field name="consultant"/>
                        <field name="consultant_phone"/>
                        <field name="consultant_email"/>
                    </group>
                    <group name="group_application_form_right">

                        <field name="scope_of_activity"/>
                        <field name="critical_processes"/>
                        <field name="legislation_relative"/>
                        <field name="permanent_personnel"/>
                        <field name="temporary_personnel"/>
                        <field name="personnel_on_shifts"/>
                        <field name="number_of_shifts"/>
                        <field name="other_certified_management_system"/>
                        <field name="level_of_integration"/>
                        <field name="license_attachment_filename" invisible="1"/>
                        <field name="license_attachment" filename="license_attachment_filename"/>
                    </group>
                </group>
                <group name="group_proposal_form" string="Proposal Form"
                    invisible="document_type != 'proposal_form'">
                    <group name="group_proposal_form_left">
                        <field name="management_system_name"/>
                    </group>
                    <group name="group_proposal_form_right">
                        <field name="certification_standard"/>
                    </group>
                </group>
                <group name="group_proposal_charges" string="Charges"
                    invisible="document_type != 'proposal_form'">
                    <group name="group_proposal_charges_left">
                        <field name="charge_stage_1_audit"/>
                        <field name="charge_stage_2_audit"/>
                        <field name="travel_boarding_lodging"/>
                    </group>
                    <group name="group_proposal_charges_right">
                        <field name="charge_surveillance_1"/>
                        <field name="charge_surveillance_2"/>
                    </group>
                </group>
                <group name="group_proposal_cost" string="Summary of Cost"
                    invisible="document_type != 'proposal_form'">
                    <group name="group_proposal_cost_amount" string="Certification Fee">
                        <field name="cost_initial_audit"/>
                        <field name="cost_surveillance_1"/>
                        <field name="cost_surveillance_2"/>
                        <field name="cost_total"/>
                    </group>
                    <group name="group_proposal_cost_tax" string="Sales Tax">
                        <field name="cost_tax_label"/>
                        <field name="cost_tax_initial_audit"/>
                        <field name="cost_tax_surveillance_1"/>
                        <field name="cost_tax_surveillance_2"/>
                        <field name="cost_tax_total"/>
                    </group>
                    <group name="group_proposal_cost_grand" string="Total">
                        <field name="cost_grand_initial_audit"/>
                        <field name="cost_grand_surveillance_1"/>
                        <field name="cost_grand_surveillance_2"/>
                        <field name="cost_grand_total"/>
                    </group>
                    <group name="group_proposal_cost_invoicing" string="Invoicing">
                        <field name="proposal_invoicing_terms"/>
                    </group>
                </group>
                <group name="group_contract_form" string="Contract Details"
                    invisible="document_type not in ('contract_form', 'pnac_contract')">
                    <group name="group_contract_form_left">
                        <field name="contract_standards"/>
                        <field name="contract_address_1"/>
                        <field name="contract_address_2"/>
                        <field name="contract_representative"/>
                    </group>
                    <group name="group_contract_form_right">
                        <field name="contract_designation"/>
                        <field name="contract_date"/>
                        <field name="contract_ref"/>
                        <field name="contract_advance_amount"/>
                    </group>
                </group>
                <group name="group_contract_services" string="Certification Services Offered"
                    invisible="document_type not in ('contract_form', 'pnac_contract')">
                    <group name="group_contract_services_1" string="Row 1">
                        <field name="contract_service_1"/>
                        <field name="contract_accreditation_1"/>
                    </group>
                    <group name="group_contract_services_2" string="Row 2">
                        <field name="contract_service_2"/>
                        <field name="contract_accreditation_2"/>
                    </group>
                </group>
                <group name="group_contract_charges" string="Contract Charges"
                    invisible="document_type not in ('contract_form', 'pnac_contract')">
                    <group name="group_contract_charges_y1" string="1st Year Initial Audit (USD)">
                        <field name="contract_fee_y1" string="Standard(s)"/>
                        <field name="contract_mandays_y1" string="*# of Man-days"/>
                        <field name="contract_tax_y1" string="Sales Tax"/>
                        <field name="contract_total_y1" string="Total Payable"/>
                    </group>
                    <group name="group_contract_charges_y2" string="2nd Year Surveillance Audit (USD)">
                        <field name="contract_fee_y2" string="Standard(s)"/>
                        <field name="contract_mandays_y2" string="*# of Man-days"/>
                        <field name="contract_tax_y2" string="Sales Tax"/>
                        <field name="contract_total_y2" string="Total Payable"/>
                    </group>
                    <group name="group_contract_charges_y3" string="3rd Year Surveillance Audit (USD)">
                        <field name="contract_fee_y3" string="Standard(s)"/>
                        <field name="contract_mandays_y3" string="*# of Man-days"/>
                        <field name="contract_tax_y3" string="Sales Tax"/>
                        <field name="contract_total_y3" string="Total Payable"/>
                    </group>
                    <group name="group_contract_charges_tax" string="Tax Row Label">
                        <field name="contract_tax_province"/>
                    </group>
                </group>
                <group name="group_pnac_annexure" string="PNAC Annexure 1 - Logos"
                    invisible="document_type != 'pnac_contract'">
                    <group name="group_pnac_logos_left">
                        <field name="pnac_logo_1_filename" invisible="1"/>
                        <field name="pnac_logo_1" widget="image"
                            filename="pnac_logo_1_filename"
                            options="{'size': [200, 90]}"/>
                        <field name="pnac_logo_3_filename" invisible="1"/>
                        <field name="pnac_logo_3" widget="image"
                            filename="pnac_logo_3_filename"
                            options="{'size': [200, 90]}"/>
                    </group>
                    <group name="group_pnac_logos_right">
                        <field name="pnac_logo_2_filename" invisible="1"/>
                        <field name="pnac_logo_2" widget="image"
                            filename="pnac_logo_2_filename"
                            options="{'size': [200, 90]}"/>
                        <field name="pnac_logo_4_filename" invisible="1"/>
                        <field name="pnac_logo_4" widget="image"
                            filename="pnac_logo_4_filename"
                            options="{'size': [200, 90]}"/>
                    </group>
                </group>
                <group name="group_proposal_prepared_by" string="Prepared By"
                    invisible="document_type != 'proposal_form'">
                    <group name="group_proposal_prepared_by_left">
                        <field name="prepared_by_name"/>
                        <field name="prepared_by_designation"/>
                        <field name="prepared_by_phone"/>
                        <field name="prepared_by_email"/>
                    </group>
                    <group name="group_proposal_prepared_by_right">
                        <field name="prepared_by_signature_filename" invisible="1"/>
                        <field name="prepared_by_signature" widget="image"
                            filename="prepared_by_signature_filename"
                            options="{'size': [200, 90]}"/>
                    </group>
                </group>
            </group>

        </field>
    </record>

</odoo>
