<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuv_technical_review_list" model="ir.ui.view">
        <field name="name">tuv.technical.review.list</field>
        <field name="model">tuv.technical.review</field>
        <field name="arch" type="xml">
            <list string="Technical Reviews" create="0"
                decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="standards" optional="show"/>
                <field name="reviewer_id"/>
                <field name="assigned_on"/>
                <field name="reviewed_on" optional="show"/>
                <field name="state" widget="badge"
                    decoration-warning="state == 'in_review'" decoration-success="state == 'approved'"
                    decoration-danger="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_tuv_technical_review_form" model="ir.ui.view">
        <field name="name">tuv.technical.review.form</field>
        <field name="model">tuv.technical.review</field>
        <field name="arch" type="xml">
            <form string="Technical Review" create="0">
                <header>
                    <button name="action_approve" type="object" string="Approve Report"
                        class="btn-primary" invisible="state != 'in_review'"/>
                    <button name="action_return" type="object" string="Return to Auditor"
                        invisible="state != 'in_review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="in_review,approved"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Approved" bg_color="text-bg-success"
                        invisible="state != 'approved'"/>
                    <widget name="web_ribbon" title="Returned" bg_color="text-bg-danger"
                        invisible="state != 'returned'"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Audit">
                            <field name="project_id"/>
                            <field name="partner_id"/>
                            <field name="standards"/>
                            <field name="ea_code_ids" widget="many2many_tags"/>
                            <field name="lead_auditor_id"/>
                            <field name="audit_scope"/>
                        </group>
                        <group string="Report">
                            <field name="report_conclusion"/>
                            <field name="report_submitted_on"/>
                            <field name="report_on_time"/>
                            <field name="major_count"/>
                            <field name="minor_count"/>
                            <field name="observation_count"/>
                            <field name="evidence_count"/>
                            <field name="evidence_late_count"
                                decoration-danger="evidence_late_count > 0"/>
                        </group>
                        <group string="Review">
                            <field name="reviewer_id"/>
                            <field name="assigned_on"/>
                            <field name="reviewed_on"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-2" role="status">
                        The audit report, checklist and evidence are on the project - open it from
                        the Project field above, or print the Audit Report from there.
                    </div>
                    <separator string="ISO/IEC 17021-1 Review Checklist"/>
                    <group col="1">
                        <field name="chk_complete" readonly="state != 'in_review'"/>
                        <field name="chk_scope" readonly="state != 'in_review'"/>
                        <field name="chk_team" readonly="state != 'in_review'"/>
                        <field name="chk_duration" readonly="state != 'in_review'"/>
                        <field name="chk_objective" readonly="state != 'in_review'"/>
                        <field name="chk_nc_grading" readonly="state != 'in_review'"/>
                        <field name="chk_evidence" readonly="state != 'in_review'"/>
                        <field name="chk_conclusion" readonly="state != 'in_review'"/>
                    </group>
                    <separator string="Reviewer Comments"/>
                    <field name="review_comments" readonly="state != 'in_review'"
                        placeholder="Required when returning the report: what the auditor has to correct."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tuv_technical_review_search" model="ir.ui.view">
        <field name="name">tuv.technical.review.search</field>
        <field name="model">tuv.technical.review</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="reviewer_id"/>
                <filter name="my_reviews" string="My Reviews" domain="[('reviewer_id', '=', uid)]"/>
                <filter name="in_review" string="In Review" domain="[('state', '=', 'in_review')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_reviewer" string="Reviewer" context="{'group_by': 'reviewer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tuv_technical_review" model="ir.actions.act_window">
        <field name="name">Technical Reviews</field>
        <field name="res_model">tuv.technical.review</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_review': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No audit report waiting for technical review</p>
            <p>The planning team sends a submitted audit report to a competent Technical
               Reviewer from the project's Audit Report tab.</p>
        </field>
    </record>

    <menuitem id="menu_tuv_technical_review"
        action="action_tuv_technical_review"
        name="Technical Reviews"
        parent="project.menu_main_pm"
        sequence="16"/>

    <!-- Project: assign the reviewer and send the report from the Audit Report tab -->
    <record id="edit_project_technical_review_tuv_austria_customization" model="ir.ui.view">
        <field name="name">project.project.form.technical.review.custom.operations</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="technical_review_state" invisible="1"/>
                <button name="action_send_to_technical_review" type="object"
                    string="Send to Technical Review" class="btn-primary"
                    groups="tuv_austria_customization.group_planning_team,base.group_system"
                    invisible="report_state != 'submitted' or technical_review_state in ('in_review', 'approved')"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_technical_reviews" type="object"
                    class="oe_stat_button" icon="fa-check-square-o"
                    invisible="not technical_review_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="technical_review_state"/></span>
                        <span class="o_stat_text">Technical Review</span>
                    </div>
                </button>
                <field name="technical_review_ids" invisible="1"/>
            </div>
            <xpath expr="//page[@name='audit_report']//group[@name='audit_report_submission']" position="after">
                <group string="Technical Review" name="technical_review" invisible="report_state != 'submitted'">
                    <field name="technical_reviewer_candidate_ids" invisible="1"/>
                    <field name="technical_reviewer_id"
                        options="{'no_create': True, 'no_open': True}"
                        readonly="technical_review_state in ('in_review', 'approved')"
                        placeholder="only competent and independent reviewers are listed"/>
                    <field name="technical_review_state" widget="badge"
                        decoration-warning="technical_review_state == 'in_review'"
                        decoration-success="technical_review_state == 'approved'"
                        decoration-danger="technical_review_state == 'returned'"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
