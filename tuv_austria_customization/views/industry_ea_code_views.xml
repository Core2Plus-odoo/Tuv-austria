<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_industry_ea_code_list" model="ir.ui.view">
        <field name="name">industry.ea.code.list</field>
        <field name="model">industry.ea.code</field>
        <field name="arch" type="xml">
            <list string="Industry / EA Code" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_industry_ea_code" model="ir.actions.act_window">
        <field name="name">Industry/EA Code</field>
        <field name="res_model">industry.ea.code</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_industry_ea_code"
        action="action_industry_ea_code"
        name="Industry/EA Code"
        parent="contacts.res_partner_menu_config"
        sequence="6"/>

</odoo>
