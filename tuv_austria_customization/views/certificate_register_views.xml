<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuv_certificate_register_list" model="ir.ui.view">
        <field name="name">tuv.certificate.register.list</field>
        <field name="model">tuv.certificate.register</field>
        <field name="arch" type="xml">
            <list string="Certificate Register" create="0" edit="0" delete="0"
                decoration-muted="status in ('superseded', 'cancelled')"
                decoration-danger="status == 'expired'" decoration-success="status == 'valid'">
                <header>
                    <button name="action_print_register" type="object" string="Print Register"
                        icon="fa-print" display="always"/>
                </header>
                <field name="name"/>
                <field name="certificate_type"/>
                <field name="client_name"/>
                <field name="client_city" optional="show"/>
                <field name="client_country" optional="hide"/>
                <field name="client_ntn" optional="show"/>
                <field name="standards"/>
                <field name="ea_codes"/>
                <field name="scope" optional="hide"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="next_surveillance_date" optional="show"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'valid'" decoration-danger="status == 'expired'"
                    decoration-muted="status in ('superseded', 'cancelled')"/>
                <field name="registered_on" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_tuv_certificate_register_form" model="ir.ui.view">
        <field name="name">tuv.certificate.register.form</field>
        <field name="model">tuv.certificate.register</field>
        <field name="arch" type="xml">
            <form string="Certificate Register Entry" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <field name="status" widget="badge"
                            decoration-success="status == 'valid'" decoration-danger="status == 'expired'"
                            decoration-muted="status in ('superseded', 'cancelled')"/>
                    </div>
                    <group>
                        <group string="Certificate">
                            <field name="certificate_type"/>
                            <field name="standards"/>
                            <field name="ea_codes"/>
                            <field name="scope"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="cycle_start_date"/>
                            <field name="next_surveillance_date"/>
                            <field name="superseded_by_id" invisible="not superseded_by_id"/>
                        </group>
                        <group string="Client">
                            <field name="client_name"/>
                            <field name="client_address"/>
                            <field name="client_city"/>
                            <field name="client_country"/>
                            <field name="client_ntn"/>
                            <field name="client_email"/>
                            <field name="client_phone"/>
                            <field name="site_address"/>
                        </group>
                        <group string="Issued">
                            <field name="lead_auditor"/>
                            <field name="technical_review"/>
                            <field name="approved_by"/>
                            <field name="registered_on"/>
                            <field name="certificate_id" groups="project.group_project_user"/>
                            <field name="project_id" groups="project.group_project_user"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tuv_certificate_register_search" model="ir.ui.view">
        <field name="name">tuv.certificate.register.search</field>
        <field name="model">tuv.certificate.register</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="client_name"/>
                <field name="standards"/>
                <field name="ea_codes"/>
                <field name="client_ntn"/>
                <filter name="current" string="Current Register" domain="[('is_current', '=', True)]"/>
                <separator/>
                <filter name="valid" string="Valid" domain="[('status', '=', 'valid')]"/>
                <filter name="expired" string="Expired" domain="[('status', '=', 'expired')]"/>
                <filter name="superseded" string="Superseded" domain="[('status', '=', 'superseded')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group>
                    <filter name="group_standard" string="Standard" context="{'group_by': 'standards'}"/>
                    <filter name="group_ea" string="EA Code" context="{'group_by': 'ea_codes'}"/>
                    <filter name="group_year" string="Year Issued" context="{'group_by': 'issue_year'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'certificate_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tuv_certificate_register" model="ir.actions.act_window">
        <field name="name">Certificate Register</field>
        <field name="res_model">tuv.certificate.register</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_current': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No certificate issued yet</p>
            <p>Every certificate is entered here automatically the moment it is approved.
               Entries cannot be edited or deleted.</p>
        </field>
    </record>

    <!-- Its own app, so a read-only PNAC user sees the register and nothing else -->
    <menuitem id="menu_tuv_certificate_register_root"
        name="Certificate Register"
        sequence="70"
        groups="tuv_austria_customization.group_register_viewer,tuv_austria_customization.group_planning_team,tuv_austria_customization.group_certificate_approver,base.group_system"/>
    <menuitem id="menu_tuv_certificate_register"
        action="action_tuv_certificate_register"
        name="Certificate Register"
        parent="menu_tuv_certificate_register_root"
        sequence="10"/>

    <!-- The certificate shows its register entry -->
    <record id="view_tuv_certificate_form_register" model="ir.ui.view">
        <field name="name">tuv.certificate.form.register</field>
        <field name="model">tuv.certificate</field>
        <field name="inherit_id" ref="tuv_austria_customization.view_tuv_certificate_form"/>
        <field name="arch" type="xml">
            <field name="prepared_on" position="after">
                <field name="register_ids" widget="many2many_tags" string="Register Entry"
                    invisible="not register_ids"/>
            </field>
        </field>
    </record>

</odoo>
