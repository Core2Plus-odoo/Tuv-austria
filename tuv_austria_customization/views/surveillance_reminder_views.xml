<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuv_surveillance_reminder_list" model="ir.ui.view">
        <field name="name">tuv.surveillance.reminder.list</field>
        <field name="model">tuv.surveillance.reminder</field>
        <field name="arch" type="xml">
            <list string="Audit Reminders" create="0" edit="0" decoration-danger="state == 'no_email'">
                <field name="sent_on"/>
                <field name="certificate_number"/>
                <field name="partner_id"/>
                <field name="standards"/>
                <field name="audit_kind"/>
                <field name="due_date"/>
                <field name="email_to"/>
                <field name="state" widget="badge" decoration-success="state == 'sent'"
                    decoration-danger="state == 'no_email'"/>
            </list>
        </field>
    </record>

    <record id="view_tuv_surveillance_reminder_form" model="ir.ui.view">
        <field name="name">tuv.surveillance.reminder.form</field>
        <field name="model">tuv.surveillance.reminder</field>
        <field name="arch" type="xml">
            <form string="Audit Reminder" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="certificate_number"/>
                            <field name="register_id"/>
                            <field name="partner_id"/>
                            <field name="standards"/>
                        </group>
                        <group>
                            <field name="audit_kind"/>
                            <field name="due_date"/>
                            <field name="sent_on"/>
                            <field name="email_to"/>
                            <field name="state"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tuv_surveillance_reminder_search" model="ir.ui.view">
        <field name="name">tuv.surveillance.reminder.search</field>
        <field name="model">tuv.surveillance.reminder</field>
        <field name="arch" type="xml">
            <search>
                <field name="certificate_number"/>
                <field name="partner_id"/>
                <filter name="no_email" string="Not Sent" domain="[('state', '=', 'no_email')]"/>
                <filter name="surveillance" string="Surveillance" domain="[('audit_kind', '=', 'surveillance')]"/>
                <filter name="recertification" string="Recertification" domain="[('audit_kind', '=', 'recertification')]"/>
                <group>
                    <filter name="group_month" string="Due (Month)" context="{'group_by': 'due_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tuv_surveillance_reminder" model="ir.actions.act_window">
        <field name="name">Audit Reminders</field>
        <field name="res_model">tuv.surveillance.reminder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No reminder sent yet</p>
            <p>Clients are reminded automatically 3 months before their next surveillance or
               recertification audit is due.</p>
        </field>
    </record>

    <menuitem id="menu_tuv_surveillance_reminder" action="action_tuv_surveillance_reminder"
        name="Audit Reminders" parent="project.menu_main_pm" sequence="22"/>

    <record id="view_tuv_certificate_form_reminder" model="ir.ui.view">
        <field name="name">tuv.certificate.form.reminder</field>
        <field name="model">tuv.certificate</field>
        <field name="inherit_id" ref="tuv_austria_customization.view_tuv_certificate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_cancel']" position="before">
                <button name="action_send_audit_reminder" type="object" string="Send Audit Reminder Now"
                    icon="fa-bell" invisible="state not in ('approved', 'printed', 'dispatched')"
                    groups="tuv_austria_customization.group_planning_team,base.group_system"/>
            </xpath>
        </field>
    </record>

    <record id="view_company_form_ba_team_tuv" model="ir.ui.view">
        <field name="name">res.company.form.ba.team.custom.operations</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="ba_team" string="BA Team (Audit Reminders)">
                    <group>
                        <group>
                            <field name="ba_team_name"/>
                            <field name="ba_team_contact"/>
                            <field name="ba_team_email" placeholder="company e-mail is used when empty"/>
                            <field name="ba_team_phone" placeholder="company phone is used when empty"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
