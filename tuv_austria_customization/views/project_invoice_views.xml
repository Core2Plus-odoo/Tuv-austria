<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project_invoice_tuv_austria_customization" model="ir.ui.view">
        <field name="name">project.project.form.invoice.custom.operations</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="commercial_invoice_id" invisible="1"/>
                <button name="action_generate_commercial_invoice" type="object"
                    string="Generate Commercial Invoice" class="btn-primary"
                    groups="tuv_austria_customization.group_planning_team,account.group_account_invoice,base.group_system"
                    invisible="audit_state != 'done' or commercial_invoice_id"/>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_commercial_invoices" type="object"
                    class="oe_stat_button" icon="fa-file-text-o"
                    groups="account.group_account_invoice,tuv_austria_customization.group_planning_team"
                    invisible="not commercial_invoice_count">
                    <field name="commercial_invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </div>
            <xpath expr="//page[@name='audit_report']//group[@name='audit_report_submission']" position="before">
                <div class="alert alert-danger" role="alert" colspan="2"
                    invisible="not invoice_blocked_reason or commercial_invoice_id">
                    Commercial invoice not generated: <field name="invoice_blocked_reason" class="fw-bold"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- The invoice shows which audit it belongs to -->
    <record id="view_move_form_audit_project_tuv" model="ir.ui.view">
        <field name="name">account.move.form.audit.project.custom.operations</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="business_line" position="after">
                <field name="tuv_project_id" invisible="not tuv_project_id"/>
            </field>
        </field>
    </record>

</odoo>
