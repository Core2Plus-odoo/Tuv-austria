<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="edit_project_payment_tuv_austria_customization" model="ir.ui.view">
        <field name="name">project.project.form.payment.custom.operations</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- the block, above everything else on the project -->
            <xpath expr="//sheet" position="before">
                <div class="alert alert-danger mb-0 text-center" role="alert"
                    invisible="not certificate_blocked_reason">
                    <i class="fa fa-lock me-1" title="Blocked"/>
                    <b>Certificate issuance blocked</b> - <field name="certificate_blocked_reason" class="d-inline"/>
                </div>
            </xpath>
            <div name="button_box" position="inside">
                <button name="action_view_commercial_invoices" type="object" class="oe_stat_button"
                    icon="fa-money" invisible="payment_status in (False, 'no_invoice')"
                    groups="account.group_account_invoice,tuv_austria_customization.group_planning_team">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="paid_percent" widget="float" digits="[3,0]"/>%</span>
                        <span class="o_stat_text">Paid</span>
                    </div>
                </button>
            </div>
            <xpath expr="//page[@name='tuv_invoicing']/group" position="inside">
                <group string="Payment Status (live)">
                    <field name="payment_currency_id" invisible="1"/>
                    <field name="payment_status" widget="badge"
                        decoration-danger="payment_status == 'not_paid'"
                        decoration-warning="payment_status == 'partial'"
                        decoration-success="payment_status == 'paid'"/>
                    <field name="amount_invoiced"/>
                    <field name="amount_paid"/>
                    <field name="amount_due"/>
                    <field name="paid_percent" widget="progressbar"/>
                    <field name="payment_due_date"/>
                    <field name="payment_overdue" invisible="1"/>
                    <field name="payment_days_overdue" invisible="not payment_overdue"
                        decoration-danger="payment_overdue"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_project_payment_list_tuv" model="ir.ui.view">
        <field name="name">project.project.list.payment.custom.operations</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="payment_status" optional="show" widget="badge"
                    decoration-danger="payment_status == 'not_paid'"
                    decoration-warning="payment_status == 'partial'"
                    decoration-success="payment_status == 'paid'"/>
                <field name="payment_due_date" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_project_filter_payment_tuv" model="ir.ui.view">
        <field name="name">project.project.search.payment.custom.operations</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="fully_paid" string="Fully Paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter name="awaiting_payment" string="Awaiting Payment"
                    domain="[('payment_status', 'in', ('not_paid', 'partial'))]"/>
                <filter name="credit_overdue" string="Credit Overdue (past 7 days)"
                    domain="[('payment_overdue', '=', True)]"/>
                <filter name="group_payment_status" string="Payment Status"
                    context="{'group_by': 'payment_status'}"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_stage_form_payment_tuv" model="ir.ui.view">
        <field name="name">project.project.stage.form.payment.custom.operations</field>
        <field name="model">project.project.stage</field>
        <field name="inherit_id" ref="project.project_project_stage_view_form"/>
        <field name="arch" type="xml">
            <field name="fold" position="after">
                <field name="requires_full_payment"/>
            </field>
        </field>
    </record>

</odoo>
