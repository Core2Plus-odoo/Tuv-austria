<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form_inherit_tuv_austria_customization" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom.operations</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <group id="header_right_group" position="inside">
                <field name="business_line"
                    invisible="move_type not in ('out_invoice', 'out_refund', 'out_receipt')"/>
            </group>
        </field>
    </record>

</odoo>
