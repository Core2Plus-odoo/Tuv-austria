<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_tuv_improvement_action_list" model="ir.ui.view">
        <field name="name">tuv.improvement.action.list</field>
        <field name="model">tuv.improvement.action</field>
        <field name="arch" type="xml">
            <list string="Corrective / Improvement Actions"
                decoration-danger="is_overdue" decoration-muted="state in ('verified', 'cancelled')">
                <field name="is_overdue" column_invisible="1"/>
                <field name="name"/>
                <field name="action_type" widget="badge"
                    decoration-danger="action_type == 'corrective'" decoration-info="action_type == 'improvement'"/>
                <field name="source" optional="show"/>
                <field name="feedback_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="auditor_id" optional="hide"/>
                <field name="action_plan"/>
                <field name="responsible_id"/>
                <field name="due_date"/>
                <field name="state" widget="badge" decoration-info="state == 'open'"
                    decoration-warning="state in ('in_progress', 'done')" decoration-success="state == 'verified'"/>
            </list>
        </field>
    </record>

    <record id="view_tuv_improvement_action_form" model="ir.ui.view">
        <field name="name">tuv.improvement.action.form</field>
        <field name="model">tuv.improvement.action</field>
        <field name="arch" type="xml">
            <form string="Action">
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'open'"/>
                    <button name="action_mark_done" type="object" string="Mark Implemented" class="btn-primary"
                        invisible="state not in ('open', 'in_progress')"/>
                    <button name="action_verify" type="object" string="Verify Effective" class="btn-primary"
                        invisible="state != 'done'"
                        groups="tuv_austria_customization.group_certification_manager,base.group_system"/>
                    <button name="action_reopen" type="object" string="Not Effective - Reopen"
                        invisible="state != 'done'"
                        groups="tuv_austria_customization.group_certification_manager,base.group_system"/>
                    <button name="action_cancel" type="object" string="Cancel"
                        invisible="state in ('verified', 'cancelled')"
                        groups="tuv_austria_customization.group_certification_manager,base.group_system"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,done,verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="state != 'verified'"/>
                    <field name="is_overdue" invisible="1"/>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Action">
                            <field name="action_type" readonly="state != 'open'"/>
                            <field name="source" readonly="state != 'open'"/>
                            <field name="feedback_id" readonly="state != 'open'"/>
                            <field name="project_id" readonly="state != 'open'"/>
                            <field name="partner_id" readonly="state != 'open'"/>
                            <field name="auditor_id" readonly="state != 'open'"/>
                        </group>
                        <group string="Ownership">
                            <field name="responsible_id" readonly="state in ('verified', 'cancelled')"/>
                            <field name="due_date" readonly="state in ('verified', 'cancelled')"/>
                            <field name="completed_on"/>
                            <field name="verified_by"/>
                            <field name="verified_on"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" readonly="state != 'open'"/>
                        <field name="root_cause" readonly="state in ('done', 'verified', 'cancelled')"
                            required="action_type == 'corrective'"/>
                        <field name="action_plan" readonly="state in ('done', 'verified', 'cancelled')"/>
                        <field name="completion_note" readonly="state in ('done', 'verified', 'cancelled')"
                            invisible="state == 'open'"/>
                        <field name="verification_note" readonly="state != 'done'"
                            invisible="state not in ('done', 'verified')"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_tuv_improvement_action_search" model="ir.ui.view">
        <field name="name">tuv.improvement.action.search</field>
        <field name="model">tuv.improvement.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="responsible_id"/>
                <filter name="my" string="My Actions" domain="[('responsible_id', '=', uid)]"/>
                <filter name="not_closed" string="Not Closed" domain="[('state', 'in', ('open', 'in_progress', 'done'))]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="to_verify" string="To Verify" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="corrective" string="Corrective" domain="[('action_type', '=', 'corrective')]"/>
                <filter name="improvement" string="Improvement" domain="[('action_type', '=', 'improvement')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'action_type'}"/>
                    <filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_tuv_improvement_action_pivot" model="ir.ui.view">
        <field name="name">tuv.improvement.action.pivot</field>
        <field name="model">tuv.improvement.action</field>
        <field name="arch" type="xml">
            <pivot string="Actions">
                <field name="action_type" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_tuv_improvement_action" model="ir.actions.act_window">
        <field name="name">Corrective / Improvement Actions</field>
        <field name="res_model">tuv.improvement.action</field>
        <field name="view_mode">list,pivot,form</field>
        <field name="context">{'search_default_not_closed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open action</p>
            <p>Actions come out of the Certification Manager's review of client feedback, or
               can be recorded here for any other finding.</p>
        </field>
    </record>

    <menuitem id="menu_tuv_improvement_action" action="action_tuv_improvement_action"
        name="Improvement Actions" parent="project.menu_main_pm" sequence="21"/>

    <!-- Client feedback: the Certification Manager's review -->
    <record id="view_tuv_client_feedback_form_review" model="ir.ui.view">
        <field name="name">tuv.client.feedback.form.review</field>
        <field name="model">tuv.client.feedback</field>
        <field name="inherit_id" ref="tuv_austria_customization.view_tuv_client_feedback_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_resend']" position="after">
                <button name="action_create_improvement_action" type="object" string="Create Action"
                    invisible="state != 'answered'"
                    groups="tuv_austria_customization.group_certification_manager,base.group_system"/>
                <button name="action_complete_review" type="object" string="Complete Review" class="btn-primary"
                    invisible="state != 'answered'"
                    groups="tuv_austria_customization.group_certification_manager,base.group_system"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="needs_attention" invisible="1"/>
                <separator string="Certification Manager Review" invisible="state == 'sent'"/>
                <div class="alert alert-danger" role="alert" invisible="not needs_attention or state != 'answered'">
                    Low feedback: at least one corrective or improvement action is required.
                </div>
                <group invisible="state == 'sent'">
                    <group>
                        <field name="review_outcome" readonly="state != 'answered'"/>
                        <field name="reviewed_by"/>
                        <field name="reviewed_on"/>
                    </group>
                    <group>
                        <field name="review_notes" nolabel="1" colspan="2" readonly="state != 'answered'"
                            placeholder="Analysis of the client's ratings and comments"/>
                    </group>
                </group>
                <field name="action_ids" invisible="not action_ids" readonly="1">
                    <list>
                        <field name="name"/>
                        <field name="action_type" widget="badge"/>
                        <field name="action_plan"/>
                        <field name="responsible_id"/>
                        <field name="due_date"/>
                        <field name="state" widget="badge"/>
                    </list>
                </field>
            </xpath>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <widget name="web_ribbon" title="Needs Attention" bg_color="text-bg-danger" invisible="not needs_attention"/>
            </xpath>
        </field>
    </record>

    <record id="view_tuv_client_feedback_search_review" model="ir.ui.view">
        <field name="name">tuv.client.feedback.search.review</field>
        <field name="model">tuv.client.feedback</field>
        <field name="inherit_id" ref="tuv_austria_customization.view_tuv_client_feedback_search"/>
        <field name="arch" type="xml">
            <filter name="answered" position="after">
                <filter name="to_review" string="To Review" domain="[('state', '=', 'answered')]"/>
                <filter name="attention" string="Needs Attention" domain="[('needs_attention', '=', True)]"/>
                <filter name="reviewed" string="Reviewed" domain="[('state', '=', 'reviewed')]"/>
            </filter>
        </field>
    </record>

    <record id="view_tuv_client_feedback_list_review" model="ir.ui.view">
        <field name="name">tuv.client.feedback.list.review</field>
        <field name="model">tuv.client.feedback</field>
        <field name="inherit_id" ref="tuv_austria_customization.view_tuv_client_feedback_list"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="needs_attention" optional="show"/>
                <field name="review_outcome" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
