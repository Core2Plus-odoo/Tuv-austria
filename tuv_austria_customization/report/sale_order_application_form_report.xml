<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Geometry taken from the client's own printout (Application Form-QMS.pdf,
         KFM-002b Rev.01): A4, left margin 23 mm, right 12 mm, so the table is 175 mm
         wide. The header block (title + TUV AUSTRIA Group + document code) is 41 mm
         tall and the footer strip sits 13 mm from the bottom edge. -->
    <record id="paperformat_application_form" model="report.paperformat">
        <field name="name">TUV Application Form (A4)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <!-- wkhtmltopdf draws the header with its top at (margin_top - header_spacing),
             so 41 - 31 puts it 10 mm below the paper edge, exactly like the original. -->
        <field name="margin_top">41</field>
        <field name="margin_bottom">14</field>
        <field name="margin_left">23</field>
        <field name="margin_right">12</field>
        <field name="header_spacing">31</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_sale_order_application_form" model="ir.actions.report">
        <field name="name">Application Form</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tuv_austria_customization.report_sale_order_application_form</field>
        <field name="report_file">tuv_austria_customization.report_sale_order_application_form</field>
        <field name="print_report_name">'Application Form - %s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_application_form"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sale_order_application_form_style">
        <style>
            /* Everything below is the original document's geometry (Application
               Form-QMS.pdf, KFM-002b Rev.01) expressed for this pipeline, where
               wkhtmltopdf turns 1 CSS px into 0.6 pt of output: a value in px is
               therefore the wanted point size divided by 0.6.
               Original: Arial, 9 pt labels, 14 pt title, 10 pt subtitle,
               8 pt document code / footer, 6 pt privacy block, 0.75 pt rules and
               2.8 pt of spacing around every row (Word cell spacing). */
            .o_body_pdf { padding: 0 !important; margin: 0 !important; max-width: none !important; }
            .tuv_af {
                font-family: Arial, "Liberation Sans", Helvetica, sans-serif;
                color: #000000; font-size: 15px;               /* 9 pt   */
            }
            .tuv_af table {
                width: 100%; table-layout: fixed;
                border-collapse: separate !important; border-spacing: 4px 2.33px;
                margin: 0; background-color: transparent !important;
            }
            .tuv_af table tr, .tuv_af table tbody { background-color: transparent !important; }
            .tuv_af table td {
                border: 1.25px solid #000000 !important;        /* 0.75 pt */
                background-color: transparent !important;
                padding: 0 8px; vertical-align: middle; font-size: 15px; word-wrap: break-word;
            }
            .tuv_af td.af_bar { text-align: center; font-weight: bold; }
            .tuv_af td.af_c { text-align: center; }
            .tuv_af td.af_b { font-weight: bold; }
            .tuv_af td.af_i { font-style: italic; }
            .tuv_af td.af_bottom { vertical-align: bottom; }
            .tuv_af .af_sm { font-size: 13.3px; }               /* 8 pt   */
            .tuv_af .af_it { font-style: italic; }
            .tuv_af a { color: #0000ff; }
            .tuv_af .af_2l { line-height: 1.15; }

            /* 8.5 pt square, 0.75 pt rule - the ticked one carries a cross. */
            .tuv_af .af_box {
                display: inline-block; width: 14.2px; height: 14.2px; line-height: 11.8px;
                border: 1.25px solid #000000; text-align: center; font-size: 11.7px;
                margin-right: 6.7px; vertical-align: middle;
            }
            .tuv_af .af_icon { height: 21px; width: auto; vertical-align: middle; }

            .tuv_af .af_title { font-size: 23.3px; font-weight: bold; text-align: center; }
            .tuv_af .af_group { font-size: 16.7px; font-weight: bold; text-align: center; }
            .tuv_af .af_code { font-size: 13.3px; text-align: right; padding: 4px 0 0 0; }
            .tuv_af .af_logo { max-height: 71px; max-width: 127px; }

            .tuv_af .af_gdpr { font-size: 10px; text-align: justify; line-height: 1.45; }
            .tuv_af .af_gdpr p { margin: 0; }
            .tuv_af .af_gdpr .af_gdpr_head { letter-spacing: 0.12em; margin-bottom: 3px; }
        </style>
    </template>

    <!-- Repeated on every page: title block + logo cell + document code -->
