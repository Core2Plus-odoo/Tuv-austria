<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_sale_order_contract_pnac" model="ir.actions.report">
        <field name="name">PNAC-Contract</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tuv_austria_customization.report_sale_order_contract_pnac</field>
        <field name="report_file">tuv_austria_customization.report_sale_order_contract_pnac</field>
        <field name="print_report_name">'PNAC-Contract - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_sale_order_contract_pnac">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-set="is_pnac" t-value="True"/>
                    <t t-call="tuv_austria_customization.report_sale_order_contract_body"/>
                </t>
            </t>
        </t>
    </template>

</odoo>
