<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_technical_review_body">
        <div class="page tuv_md">
            <style>
                .tuv_md { font-family: Arial, Helvetica, sans-serif; color: #000000; font-size: 11.5px; }
                .tuv_md .md_title { text-align: center; font-size: 17px; font-weight: 800; margin-bottom: 5px; }
                .tuv_md .md_subtitle { text-align: center; font-size: 12px; margin-bottom: 14px; }
                .tuv_md table.md_tbl { width: 100%; border-collapse: collapse; table-layout: fixed; margin-bottom: 14px; }
                .tuv_md table.md_tbl td, .tuv_md table.md_tbl th { border: 1px solid #000000; padding: 4px 6px; vertical-align: top; }
                .tuv_md table.md_tbl th, .tuv_md table.md_tbl td.md_lbl { background-color: #D9D9D9; font-weight: 700; }
                .tuv_md table.md_tbl td.md_section { background-color: #D9D9D9; font-weight: 700; text-align: center; }
                .tuv_md table.md_tbl tr { page-break-inside: avoid; }
            </style>

            <div class="md_title">Technical Review of the Audit Report</div>
            <div class="md_subtitle"><span t-field="doc.name"/> - <span t-field="doc.state"/></div>

            <table class="md_tbl">
                <colgroup>
                    <col style="width: 20%;"/><col style="width: 30%;"/>
                    <col style="width: 20%;"/><col style="width: 30%;"/>
                </colgroup>
                <tr><td class="md_section" colspan="4">AUDIT</td></tr>
                <tr>
                    <td class="md_lbl">Client</td><td><span t-field="doc.partner_id.name"/></td>
                    <td class="md_lbl">Project</td><td><span t-field="doc.project_id.name"/></td>
                </tr>
                <tr>
                    <td class="md_lbl">Standard(s)</td><td><span t-field="doc.standards"/></td>
                    <td class="md_lbl">EA Code</td><td><t t-esc="', '.join(doc.ea_code_ids.mapped('name'))"/></td>
                </tr>
                <tr>
                    <td class="md_lbl">Lead Auditor</td><td><span t-field="doc.lead_auditor_id.name"/></td>
                    <td class="md_lbl">Auditor's Conclusion</td><td><span t-field="doc.report_conclusion"/></td>
                </tr>
                <tr>
                    <td class="md_lbl">Findings</td>
                    <td colspan="3">
                        Major NC <t t-esc="doc.major_count"/> - Minor NC <t t-esc="doc.minor_count"/>
                        - Observations <t t-esc="doc.observation_count"/>
                    </td>
                </tr>
                <tr>
                    <td class="md_lbl">Evidence</td>
                    <td colspan="3">
                        <t t-esc="doc.evidence_count"/> file(s),
                        <t t-esc="doc.evidence_late_count"/> uploaded after the audit day
                    </td>
                </tr>
            </table>

            <table class="md_tbl">
                <colgroup><col style="width: 88%;"/><col style="width: 12%;"/></colgroup>
                <tr><td class="md_section" colspan="2">ISO/IEC 17021-1 REVIEW CHECKLIST</td></tr>
                <t t-foreach="['chk_complete', 'chk_scope', 'chk_team', 'chk_duration', 'chk_objective', 'chk_nc_grading', 'chk_evidence', 'chk_conclusion']" t-as="check">
                    <tr>
                        <td><t t-esc="doc._fields[check].string"/></td>
                        <td style="text-align: center; font-weight: 700;"><t t-esc="'Yes' if doc[check] else 'No'"/></td>
                    </tr>
                </t>
            </table>

            <table class="md_tbl">
                <colgroup><col style="width: 25%;"/><col style="width: 75%;"/></colgroup>
                <tr><td class="md_section" colspan="2">OUTCOME</td></tr>
                <tr><td class="md_lbl">Decision</td><td style="font-weight: 800;"><span t-field="doc.state"/></td></tr>
                <tr><td class="md_lbl">Comments</td><td><span t-field="doc.review_comments"/></td></tr>
                <tr><td class="md_lbl">Technical Reviewer</td><td><span t-field="doc.reviewer_id.name"/></td></tr>
                <tr><td class="md_lbl">Reviewed On</td><td><span t-field="doc.reviewed_on" t-options="{'widget': 'date'}"/></td></tr>
            </table>
        </div>
    </template>

    <template id="report_technical_review">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <t t-call="tuv_austria_customization.report_technical_review_body"/>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_technical_review" model="ir.actions.report">
        <field name="name">Technical Review</field>
        <field name="model">tuv.technical.review</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tuv_austria_customization.report_technical_review</field>
        <field name="report_file">tuv_austria_customization.report_technical_review</field>
        <field name="print_report_name">'Technical Review - %s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" ref="model_tuv_technical_review"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
