<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="md_scheme_view_list" model="ir.ui.view">
        <field name="name">md.scheme.list</field>
        <field name="model">md.scheme</field>
        <field name="arch" type="xml">
            <list string="Certification Schemes">
                <field name="sequence" widget="handle"/>
                <field name="short_name"/>
                <field name="name"/>
                <field name="scheme_type"/>
                <field name="duration_line_count" string="Duration Values"/>
                <field name="risk_category_count" string="Risk Lines"/>
                <field name="factor_count" string="Factors"/>
                <field name="section_count" string="Sections"/>
                <field name="complexity_levels" optional="show"/>
                <field name="document_reference" optional="show"/>
                <field name="revision" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="md_scheme_view_form" model="ir.ui.view">
        <field name="name">md.scheme.form</field>
        <field name="model">md.scheme</field>
        <field name="arch" type="xml">
            <form string="Certification Scheme">
                <header>
                    <button name="action_import_annex" type="object" string="Import from Annex"
                        class="btn-primary" groups="tuv_md_calculation.group_md_manager"
                        help="Read the Word annex again and refresh every tab from it."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                        invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="ISO/IEC 20000-1:2018"/></h1>
                        <field name="short_name" placeholder="ISO 20000"/>
                    </div>
                    <group>
                        <group string="Scheme">
                            <field name="scheme_type" placeholder="IT Service MS"/>
                            <field name="duration_basis"/>
                            <field name="complexity_levels" invisible="not complexity_levels"/>
                            <field name="risk_category_count" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Source Document">
                            <field name="document_reference"/>
                            <field name="document_code"/>
                            <field name="revision"/>
                            <field name="annex_filename" invisible="1"/>
                            <field name="annex_file" filename="annex_filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="annex" string="Annex (as printed)">
                            <field name="annex_preview" nolabel="1" readonly="1"/>
                        </page>
                        <page name="sections" string="Sections"
                            groups="tuv_md_calculation.group_md_manager">
                            <field name="section_ids" nolabel="1">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="name"/>
                                        <field name="sequence"/>
                                    </group>
                                    <field name="body" nolabel="1"/>
                                    <field name="image" widget="image" options="{'size': [700, 0]}"/>
                                </form>
                            </field>
                        </page>
                        <page name="duration" string="Audit Duration Table">
                            <field name="duration_intro" placeholder="The sentence the annex prints above the table..."/>
                            <field name="duration_line_ids">
                                <list editable="bottom" default_order="audit_kind, personnel_from, complexity">
                                    <field name="personnel_label" string="Personnel"/>
                                    <field name="personnel_from" optional="hide"/>
                                    <field name="personnel_to" optional="hide"/>
                                    <field name="complexity" optional="show"/>
                                    <field name="audit_kind" optional="show"/>
                                    <field name="audit_days" sum="Days"/>
                                    <field name="days_note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page name="risk" string="Risk / Complexity Categories"
                            invisible="risk_category_count == 0">
                            <field name="risk_category_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="category"/>
                                    <field name="ea_code"/>
                                    <field name="nace_codes"/>
                                    <field name="business_sector"/>
                                </list>
                            </field>
                        </page>
                        <page name="time_chart" string="Original Chart"
                            invisible="not time_chart_image">
                            <field name="time_chart_image" widget="image" options="{'size': [700, 0]}"/>
                        </page>
                        <page name="factors" string="Adjustment Factors">
                            <field name="factor_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="factor_type"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page name="multi_site" string="Multiple Sites">
                            <field name="multi_site_note"
                                placeholder="How a representative number of sites is sampled..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="md_scheme_view_search" model="ir.ui.view">
        <field name="name">md.scheme.search</field>
        <field name="model">md.scheme</field>
        <field name="arch" type="xml">
            <search string="Schemes">
                <field name="name"/>
                <field name="short_name"/>
                <field name="scheme_type"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group name="group_by">
                    <filter name="group_scheme_type" string="Management System"
                        context="{'group_by': 'scheme_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="md_scheme_action" model="ir.actions.act_window">
        <field name="name">Certification Schemes</field>
        <field name="res_model">md.scheme</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the first scheme</p>
            <p>
                One record per annex of VB-BA-ZET-MS-All-003: the audit duration table
                of the standard and the factors that adjust the audit time.
            </p>
        </field>
    </record>

    <record id="md_duration_line_view_list" model="ir.ui.view">
        <field name="name">md.duration.line.list</field>
        <field name="model">md.duration.line</field>
        <field name="arch" type="xml">
            <list string="Audit Duration Table" editable="bottom">
                <field name="scheme_id"/>
                <field name="personnel_from"/>
                <field name="personnel_to"/>
                <field name="band" readonly="1"/>
                <field name="audit_days"/>
            </list>
        </field>
    </record>

    <record id="md_duration_line_action" model="ir.actions.act_window">
        <field name="name">Audit Duration Tables</field>
        <field name="res_model">md.duration.line</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_scheme': 1}</field>
    </record>

    <record id="md_scheme_view_kanban" model="ir.ui.view">
        <field name="name">md.scheme.kanban</field>
        <field name="model">md.scheme</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong class="fs-5"><field name="short_name"/></strong>
                                <div class="text-muted"><field name="name"/></div>
                                <div class="o_text_overflow"><field name="scheme_type"/></div>
                            </div>
                            <div class="col-4 text-end">
                                <span class="badge text-bg-primary" title="Audit duration values">
                                    <field name="duration_line_count"/> values</span>
                                <div class="mt-1 small text-muted">
                                    <field name="factor_count"/> factors
                                </div>
                                <div class="small text-muted" invisible="risk_category_count == 0">
                                    <field name="risk_category_count"/> risk lines
                                </div>
                            </div>
                        </div>
                        <div class="mt-2 small text-muted">
                            <field name="document_reference"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
