        <record id="md_factor_iso20000_decrease_01" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">10</field>
            <field name="name">A low rate of change to the SMS and the services</field>
        </record>
        <record id="md_factor_iso20000_decrease_02" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">20</field>
            <field name="name">Previously demonstrated effective performance of the SMS, e.g. previously certified with another accredited certification body</field>
        </record>
        <record id="md_factor_iso20000_decrease_03" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">30</field>
            <field name="name">Combined audit of the SMS with one or more other relevant management systems</field>
        </record>
        <record id="md_factor_iso20000_decrease_04" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">40</field>
            <field name="name">Prior knowledge of the organization, e.g. already certified to another standard by the same certification body</field>
        </record>
        <record id="md_factor_iso20000_decrease_05" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">50</field>
            <field name="name">A single, simple service</field>
        </record>
        <record id="md_factor_iso20000_decrease_06" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">60</field>
            <field name="name">Identical activities performed on all shifts, with appropriate evidence of equivalent performance on all shifts, e.g. service desk</field>
        </record>
        <record id="md_factor_iso20000_decrease_07" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">70</field>
            <field name="name">A significant proportion of service management personnel carry out a similar simple function</field>
        </record>
        <record id="md_factor_iso20000_decrease_08" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">80</field>
            <field name="name">Single site with low number of personnel</field>
        </record>
        <record id="md_factor_iso20000_decrease_09" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">decrease</field>
            <field name="sequence">90</field>
            <field name="name">A low level of reliance on other parties, such as suppliers, internal groups or customers acting as suppliers, involved in the provision of services</field>
        </record>
        <record id="md_factor_iso20000_increase_01" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">10</field>
            <field name="name">Complicated logistics involving multi-jurisdiction, multi-site working, in the same, or across a number of, time zone(s)</field>
        </record>
        <record id="md_factor_iso20000_increase_02" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">20</field>
            <field name="name">Complexity of language differences across different locations, e.g. personnel speaking in more than one language (requiring interpreter(s) or preventing individual auditors from working independently)</field>
        </record>
        <record id="md_factor_iso20000_increase_03" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">30</field>
            <field name="name">Large size or complexity of the SMS scope, e.g. high number of services, personnel or locations, specialized services which are difficult to understand and maintain</field>
        </record>
        <record id="md_factor_iso20000_increase_04" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">40</field>
            <field name="name">High degree of legal and regulatory requirements affecting the client's SMS, e.g. intellectual property rights, privacy, food, drug, aerospace, nuclear</field>
        </record>
        <record id="md_factor_iso20000_increase_05" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">50</field>
            <field name="name">Different activities done in different shifts</field>
        </record>
        <record id="md_factor_iso20000_increase_06" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">60</field>
            <field name="name">Temporary sites within the scope of the SMS for a specific audit</field>
        </record>
        <record id="md_factor_iso20000_increase_07" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">70</field>
            <field name="name">Complex business processes performed within the scope of the SMS</field>
        </record>
        <record id="md_factor_iso20000_increase_08" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">80</field>
            <field name="name">A high level of reliance on other parties, such as suppliers, internal groups or customers acting as suppliers, involved in the provision of services</field>
        </record>
        <record id="md_factor_iso20000_increase_09" model="md.adjustment.factor">
            <field name="scheme_id" ref="md_scheme_iso_20000"/>
            <field name="factor_type">increase</field>
            <field name="sequence">90</field>
            <field name="name">Frequent addition of new services, removal of services, transfer of services or significant changes to services</field>
        </record>

